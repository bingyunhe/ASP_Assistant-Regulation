<!-- Modified for ASP Assistant Regulation on 2026-11-10; local share result. -->
<Window x:Class="ASPAssistant.App.Windows.ShareLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="阵容分享" Width="460" Height="230" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" Icon="{StaticResource AspaLogo}"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Tag="{StaticResource IconClose}" ToolTip="关闭" Click="OnClose" Style="{StaticResource DialogCloseButton}" />
                    <TextBlock Style="{StaticResource DialogTitleText}" Text="阵容分享 · 链接已生成" />
                </DockPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,14,12">
                <Button Style="{StaticResource DialogSecondaryButton}" Content="关闭" Click="OnClose" Margin="0,0,8,0" />
                <Button Style="{StaticResource DialogPrimaryButton}" x:Name="CopyButton" Content="复制链接" Click="OnCopy" />
            </StackPanel>
            <StackPanel Margin="14,12">
                <TextBlock Text="将此链接发给其他玩家，即可通过“导入”添加阵容。"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Style="{StaticResource DialogTextBox}" x:Name="LinkBox" IsReadOnly="True" TextWrapping="NoWrap" />
                <TextBlock x:Name="CopyStatusText" Text="链接已生成，正在复制…" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
