<Window x:Class="ASPAssistant.App.Windows.SimplePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
        xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择"
        Width="420" Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />
    </Window.Resources>
    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Tag="{StaticResource IconClose}" ToolTip="关闭" Click="OnCancelClick"
                            Style="{StaticResource DialogCloseButton}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DialogTitleText}" x:Name="TitleText" Text="选择" />
                        <CheckBox x:Name="CoreEquipmentToggle" Content="设为核心" Visibility="Collapsed"
                                  FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"
                                  Foreground="{DynamicResource TitleTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Padding="12,10,12,6">
                <TextBox Style="{StaticResource DialogTextBox}" x:Name="SearchBox" FontSize="12"
                         TextChanged="OnSearchTextChanged" />
            </Border>

            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
                <DockPanel>
                    <Button Style="{StaticResource DialogPrimaryButton}" x:Name="ConfirmButton" DockPanel.Dock="Right" Content="确定" Click="OnConfirmClick"
                            Visibility="Collapsed" Margin="8,0,0,0" />
                    <Button Style="{StaticResource DialogSecondaryButton}" DockPanel.Dock="Right" Content="清除选择" Click="OnClearClick" />
                    <TextBlock x:Name="HintText" Text=""
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" Padding="8,0,4,8"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     SelectionChanged="OnItemSelected" MouseDoubleClick="OnItemDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Padding="10,8">
                                    <TextBlock Text="{Binding Summary}" Width="300" MaxHeight="240" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bg" Height="48" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary}" Value="{x:Null}">
                                <Setter Property="ToolTip" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <controls:Avatar DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,10,0"
                                             Text="{Binding Display}" Source="{Binding IconPath}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding RightLabel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,2,0"
                                       TextAlignment="Right" />
                            <TextBlock Text="{Binding Display}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
