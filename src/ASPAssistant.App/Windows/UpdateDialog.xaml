<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<Window x:Class="ASPAssistant.App.Windows.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="发现新版本"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button Tag="{StaticResource IconClose}" ToolTip="关闭" Click="OnClose" DockPanel.Dock="Right"
                            Style="{StaticResource DialogCloseButton}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitleText}" Padding="4,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <StackPanel DockPanel.Dock="Bottom" Margin="16">
                <!-- Version info -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="当前版本  " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="最新版本  " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        <TextBlock x:Name="LatestVersionText" Foreground="{DynamicResource SuccessTextBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <!-- Release notes -->
                <TextBlock Text="更新内容" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" Margin="0,0,0,4" />
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RowCornerRadius}" Padding="8" Margin="0,0,0,14">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReleaseNotesText"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11" TextWrapping="Wrap" LineHeight="18" />
                    </ScrollViewer>
                </Border>

                <!-- Hint: download is running in background -->
                <TextBlock x:Name="DownloadHintText"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Text="正在后台下载更新，完成后横幅将显示重启按钮。" />

                <!-- Download progress -->
                <DockPanel Margin="0,0,0,14">
                    <TextBlock x:Name="ProgressPercentText" DockPanel.Dock="Right"
                               Text="0%" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SuccessTextBrush}" />
                    <ProgressBar x:Name="DialogProgress"
                                 Height="4" Minimum="0" Maximum="100" Value="0"
                                 VerticalAlignment="Center"
                                 Background="{DynamicResource SectionBackgroundBrush}"
                                 Foreground="{DynamicResource AccentSolidBrush}"
                                 BorderThickness="0" />
                </DockPanel>

                <!-- Buttons -->
                <DockPanel HorizontalAlignment="Right">
                    <Button Content="关闭" Click="OnClose" Style="{StaticResource DialogSecondaryButton}" Margin="0" />
                </DockPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
