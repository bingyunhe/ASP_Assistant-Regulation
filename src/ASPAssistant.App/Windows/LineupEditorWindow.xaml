<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<Window x:Class="ASPAssistant.App.Windows.LineupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑阵容"
        Width="980" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="EditorPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButton}" />
        <Style x:Key="EditorSecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}" />

        <!-- Text-only footer action (清空本阶段 / 撤销修改) -->
        <Style x:Key="EditorGhostButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Phase switch segment; Tag="active" marks the open one -->
        <Style x:Key="PhaseSegment" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Equipment / transformation tile. Tag: null = gear, "core" = 核心装备, "shape" = 变形同构体,
            "tr" = a transformation, "add" = empty (dashed). Disabled = locked until 精锐.
        -->
        <Style x:Key="EditorTile" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="frame" RadiusX="{DynamicResource RowRadiusValue}" RadiusY="{DynamicResource RowRadiusValue}" StrokeThickness="1"
                                       Fill="{DynamicResource SectionBackgroundBrush}" Stroke="{DynamicResource LineBrush}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="core">
                                <Setter TargetName="frame" Property="Fill" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="Tag" Value="shape">
                                <Setter TargetName="frame" Property="Fill" Value="{DynamicResource EliteTintBrush}" />
                                <Setter TargetName="frame" Property="Stroke" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource EliteBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="Tag" Value="tr">
                                <Setter TargetName="frame" Property="Fill" Value="{DynamicResource EliteTintBrush}" />
                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource EliteBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource EliteBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="Tag" Value="add">
                                <Setter TargetName="frame" Property="Fill" Value="Transparent" />
                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource BorderBrush}" />
                                <Setter TargetName="frame" Property="StrokeDashArray" Value="3 2" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="frame" Property="Fill" Value="Transparent" />
                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource LineBrush}" />
                                <Setter TargetName="frame" Property="StrokeDashArray" Value="3 2" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slot tag (叠层 / 输出 / 控场 / 经济, strategy 优选 / 次选); Tag="active" when set -->
        <Style x:Key="TagChip" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="{DynamicResource PillCornerRadius}" Padding="6,1" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource LineBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Tag="{StaticResource IconClose}" ToolTip="关闭" Click="OnCancelClick"
                            Style="{StaticResource DialogCloseButton}" />
                    <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Content="─" Click="OnMinimize"
                            ToolTip="最小化" Style="{StaticResource TitleBarButton}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="编辑阵容" Style="{StaticResource DialogTitleText}" />
                        <TextBlock x:Name="TitleMeta" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TitleMutedBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel x:Name="EditorContent">
            <!-- Footer: validation on the left, actions on the right -->
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="清空本阶段" Style="{StaticResource EditorGhostButton}" Click="OnClearClick" Margin="0,0,2,0" />
                        <Button Content="撤销修改" Style="{StaticResource EditorGhostButton}" Click="OnResetClick" Margin="0,0,10,0"
                                ToolTip="恢复到打开编辑器时的样子" />
                        <Button Content="取消" Style="{StaticResource EditorSecondaryButton}" Click="OnCancelClick" Margin="0,0,8,0" />
                        <Button Content="保存" Style="{StaticResource EditorPrimaryButton}" Click="OnSaveClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Path x:Name="WarningIcon" Width="13" Height="12" Margin="0,0,6,0" Stretch="Uniform" Visibility="Collapsed"
                              Data="M12,4 L21,20 L3,20 Z M12,10 L12,14.5 M12,17.2 L12,17.5" StrokeThickness="2" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource TransitionTextBrush}" />
                        <TextBlock x:Name="EditorHint" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <DockPanel x:Name="SlotsPanel" Margin="16,14,16,12">
                    <!-- name · phase switch · 策略 -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="StrategyTab" DockPanel.Dock="Right" Height="34" Padding="12,0" Margin="8,0,0,0"
                                Style="{StaticResource DialogSecondaryButton}" Click="OnStrategyTabClick">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconStar}" StrokeThickness="2" StrokeLineJoin="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="StrategyTabText" Text="策略" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="3" CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                            <StackPanel x:Name="PhaseTabs" Orientation="Horizontal" />
                        </Border>
                        <TextBox Style="{StaticResource DialogTextBox}" x:Name="LineupNameBox" FontSize="14" FontWeight="Bold" MinHeight="34"
                                 Padding="10,4" VerticalContentAlignment="Center" TextChanged="OnLineupNameChanged" ToolTip="阵容名" />
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- strategy-only piece (暴躁铁皮): outside the 9 places -->
                            <ContentControl x:Name="MechHost" Focusable="False" Margin="0,0,0,10" Visibility="Collapsed" />
                            <ItemsControl x:Name="SlotsHost" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" Margin="0,0,-8,0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Right: covenants (as people) + this lineup's strategies -->
                <Border x:Name="CovenantPanel" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,14,14,12">
                            <TextBlock Text="盟约" Style="{StaticResource FilterSectionTitle}" Margin="0,0,0,8" />
                            <StackPanel x:Name="CovenantList" />
                            <TextBlock x:Name="CovenantEmpty" Text="还没有盟约" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="策略" Style="{StaticResource FilterSectionTitle}" Margin="0,14,0,8" />
                            <StackPanel x:Name="StrategyList" />
                            <TextBlock x:Name="StrategyEmpty" Text="未选择策略" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
