<!-- Modified for ASP Assistant Regulation on 2026-11-09; see NOTICE. -->
<Window x:Class="ASPAssistant.App.Windows.LineupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
        xmlns:models="clr-namespace:ASPAssistant.Core.Models;assembly=ASPAssistant.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="阵容编辑"
        Width="980" Height="740" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />

        <Style x:Key="EditorPrimaryButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PrimaryActionHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorSecondaryButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small pill-shaped chip used for tags / equipment slots inside slot card -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Background" Value="{DynamicResource NeutralSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralStrongBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="Tag" Value="core">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource FilterSelectedTintBrush}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource FilterSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource FilterSelectedBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnCancelClick"
                            Style="{StaticResource CloseButton}" />
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="阵容编辑器" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Bottom action bar -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource TitleBackgroundBrush}" Padding="12,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="ResetButton" Content="重置" Style="{StaticResource EditorSecondaryButton}"
                                Click="OnResetClick" Margin="0,0,8,0" />
                        <Button x:Name="ClearButton" Content="清空" Style="{StaticResource EditorSecondaryButton}"
                                Click="OnClearClick" Margin="0,0,8,0" />
                        <Button Content="取消" Style="{StaticResource EditorSecondaryButton}"
                                Click="OnCancelClick" Margin="0,0,8,0" />
                        <Button Content="保存" Style="{StaticResource EditorPrimaryButton}"
                                Click="OnSaveClick" />
                    </StackPanel>
                    <TextBlock x:Name="EditorHint"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <!-- Body: slots grid + covenant panel -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <!-- Slots grid -->
                <DockPanel x:Name="SlotsPanel" Grid.Column="0" Margin="12">
                    <!-- 名字 + 开局策略：左右两栏，省下竖向空间给下面的干员格 -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：名字 + 激活摘要 -->
                        <Border Grid.Column="0" Margin="0,0,5,0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="阵容名" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10" />
                                <TextBox x:Name="LineupNameBox"
                                         Background="{DynamicResource InputOverlayBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="0,0,0,1"
                                         Padding="2,4" FontSize="14" Margin="0,2,0,0"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         TextChanged="OnLineupNameChanged" />
                                <TextBlock x:Name="ActivatedSummaryText" Margin="0,8,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Text="激活 0 个盟约" />
                            </StackPanel>
                        </Border>

                        <!-- 右：开局策略（一局只能选一个） -->
                        <Border x:Name="OpeningStrategyCard" Grid.Column="1" Margin="5,0,0,0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="OpeningStrategyPickButton" DockPanel.Dock="Right"
                                            Content="选择" Style="{DynamicResource EditorSecondaryButton}"
                                            Padding="10,1" FontSize="11" VerticalAlignment="Center"
                                            Click="OnPickOpeningStrategy" />
                                    <TextBlock Text="开局策略" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="一局一个，定初始生命值" FontSize="10"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DockPanel>
                                <StackPanel x:Name="OpeningStrategyHost" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 升本计划：2–6 本各一个回合区间，一行排开 -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="UpgradeReminderToggle"
                                          DockPanel.Dock="Right"
                                          Content="看情况自行判断升本（勾上就不提醒）"
                                          FontSize="11"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Checked="OnUpgradeReminderToggled"
                                          Unchecked="OnUpgradeReminderToggled" />
                                <TextBlock Text="升本计划" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="填回合区间，不填就是没打算" FontSize="10"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </DockPanel>

                            <WrapPanel x:Name="UpgradeRangeHost" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                        <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="3"
                                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="2 本" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBox x:Name="UpgradeFromBox2" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                        <TextBlock Text="–" FontSize="11" Margin="3,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox x:Name="UpgradeToBox2" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                        <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="3"
                                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="3 本" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBox x:Name="UpgradeFromBox3" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                        <TextBlock Text="–" FontSize="11" Margin="3,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox x:Name="UpgradeToBox3" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                        <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="3"
                                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="4 本" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBox x:Name="UpgradeFromBox4" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                        <TextBlock Text="–" FontSize="11" Margin="3,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox x:Name="UpgradeToBox4" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                        <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="3"
                                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="5 本" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBox x:Name="UpgradeFromBox5" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                        <TextBlock Text="–" FontSize="11" Margin="3,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox x:Name="UpgradeToBox5" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                        <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="3"
                                                Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="6 本" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBox x:Name="UpgradeFromBox6" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                        <TextBlock Text="–" FontSize="11" Margin="3,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox x:Name="UpgradeToBox6" Width="34"
                                                 Background="{DynamicResource InputOverlayBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 BorderThickness="0,0,0,1" Padding="0,2"
                                                 FontSize="12" TextAlignment="Center"
                                                 MaxLength="2" VerticalAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="OnUpgradeRoundChanged" />
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock x:Name="UpgradePlanHint" Margin="0,2,0,0" FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <WrapPanel x:Name="PhaseTabs" DockPanel.Dock="Top" Margin="4,0,0,6" />

                    <!-- 9 slot cards in 3x3 grid，撑满剩余高度，不滚动 -->
                    <ItemsControl x:Name="SlotsHost" VerticalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="3" Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>

                <!-- Right: covenant breakdown -->
                <Border x:Name="CovenantPanel" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="盟约层数"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Padding="12,10,12,4" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CovenantStatsList" Padding="10,4,10,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,4" Margin="0,0,0,4"
                                                Tag="{Binding Activated}"
                                                Loaded="OnCovenantRowLoaded">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{Binding Count, Mode=OneWay}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding ActivateCount, Mode=OneWay, TargetNullValue='?'}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
