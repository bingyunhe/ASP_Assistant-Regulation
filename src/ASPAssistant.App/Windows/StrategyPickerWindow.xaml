<Window x:Class="ASPAssistant.App.Windows.StrategyPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
        Title="选择策略" Width="700" Height="660" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="TagSeg" TargetType="ToggleButton" BasedOn="{StaticResource ClickableToggleButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Height="22" Padding="8,0" CornerRadius="{DynamicResource DotCornerRadius}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Tag="{StaticResource IconClose}" ToolTip="关闭" Click="OnCancelClick" Style="{StaticResource DialogCloseButton}" />
                    <TextBlock Style="{StaticResource DialogTitleText}" Text="选择策略" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
                <DockPanel>
                    <Button Style="{StaticResource DialogPrimaryButton}" DockPanel.Dock="Right" Content="完成" Margin="8,0,0,0" Click="OnConfirmClick" />
                    <Button Style="{StaticResource DialogSecondaryButton}" DockPanel.Dock="Right" Content="全部取消" Click="OnClearClick" />
                    <TextBlock Text="单击加入或移出，可选多个" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>
            </Border>
            <DockPanel Margin="14,12,14,10">
                <Border DockPanel.Dock="Top" Margin="0,0,0,9" Padding="10,4" MinHeight="34"
                        CornerRadius="{DynamicResource RowCornerRadius}" Background="{DynamicResource SectionBackgroundBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="一局只带其中一个" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock DockPanel.Dock="Left" Text="本阵容" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl x:Name="ChosenList" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="26" Margin="0,2,5,2" Padding="3,0,8,0" BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}"
                                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:Avatar Width="20" Height="20" Small="True" Margin="0,0,6,0" Text="{Binding Name}" Source="{Binding IconPath}" />
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding TagText}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                    <ListBox x:Name="KindList" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource SegmentedListBox}" SelectionChanged="OnFilterChanged">
                        <ListBoxItem Content="全部" IsSelected="True" />
                        <ListBoxItem Content="被动" />
                        <ListBoxItem Content="主动" />
                    </ListBox>
                    <TextBox x:Name="SearchBox" Style="{StaticResource PickerSearchBox}" Tag="策略、发起人或首字母，如 jjzs" TextChanged="OnFilterChanged" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnItemClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClickableListBoxItemBase}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,4,6" />
                                <Setter Property="ToolTip" Value="{Binding Summary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row" MinHeight="64" Padding="10,8,12,8" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}"
                                                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Avatar Width="44" Height="44" Small="True" Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding Name}" Source="{Binding IconPath}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Initiator}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M12 20 C12 20 5 15.6 5 10 A4 4 0 0 1 12 7.4 A4 4 0 0 1 19 10 C19 15.6 12 20 12 20 Z" Width="11" Height="11" Stretch="Uniform"
                                                  Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding InitialHp}" Margin="3,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Border x:Name="kind" Margin="0,4,0,0" Padding="6,0" HorizontalAlignment="Left" CornerRadius="{DynamicResource PillCornerRadius}"
                                                Background="{DynamicResource SectionBackgroundBrush}">
                                            <TextBlock x:Name="kindText" Text="{Binding KindText}" FontSize="10" LineHeight="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="3" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}" Padding="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" FontSize="11" LineHeight="16" MaxHeight="32" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border Grid.Column="4" Margin="12,0,0,0" Padding="2" VerticalAlignment="Center" BorderThickness="1"
                                            CornerRadius="{DynamicResource RowCornerRadius}" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            Visibility="{Binding IsChosen, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Content="核心" Style="{StaticResource TagSeg}" IsChecked="{Binding IsCore, Mode=TwoWay}" ToolTip="核心策略会写进规划" />
                                            <ToggleButton Content="优选" Style="{StaticResource TagSeg}" IsChecked="{Binding IsPreferred, Mode=TwoWay}" />
                                            <ToggleButton Content="次选" Style="{StaticResource TagSeg}" IsChecked="{Binding IsSecond, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="kind" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter TargetName="kindText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="kindText" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:EmptyState x:Name="EmptyHint" Icon="{StaticResource IconStar}" Title="没有符合条件的策略" Hint="换个关键词试试。" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
