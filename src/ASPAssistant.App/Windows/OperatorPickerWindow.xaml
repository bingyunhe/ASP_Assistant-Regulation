<Window x:Class="ASPAssistant.App.Windows.OperatorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
        xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
        Title="选择干员" Width="780" Height="700" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />
        <converters:TierToRomanConverter x:Key="TierToRoman" />
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <ItemsPanelTemplate x:Key="ChipWrap"><WrapPanel /></ItemsPanelTemplate>
        <DataTemplate x:Key="ChipTemplate"><ToggleButton Style="{StaticResource FilterChipToggle}" /></DataTemplate>
        <DataTemplate x:Key="CorePill">
            <Border CornerRadius="{DynamicResource PillCornerRadius}" Padding="6,0" Margin="0,0,4,0" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="{Binding}" FontSize="10" LineHeight="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ExtraPill">
            <Border CornerRadius="{DynamicResource PillCornerRadius}" Padding="6,0" Margin="0,0,4,0" Background="{DynamicResource NeutralTintBrush}">
                <TextBlock Text="{Binding}" FontSize="10" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Tag="{StaticResource IconClose}" ToolTip="关闭" Click="OnCancelClick" Style="{StaticResource DialogCloseButton}" />
                    <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Content="─" Click="OnMinimize"
                            ToolTip="最小化" Style="{StaticResource TitleBarButton}" />
                    <TextBlock Style="{StaticResource DialogTitleText}" Text="选择干员" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
                <DockPanel>
                    <Button Style="{StaticResource DialogSecondaryButton}" DockPanel.Dock="Right" Content="清除选择" Click="OnClearClick" />
                    <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding FilteredOperators.Count, Mode=OneWay}" /><Run Text=" 位干员 · 单击或按 Enter 选择" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="1.2*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource DialogSecondaryButton}" x:Name="ResetFiltersButton" DockPanel.Dock="Right" Content="重置筛选" Click="OnResetFiltersClick" Margin="8,0,0,0" />
                    <TextBox Style="{StaticResource DialogTextBox}" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索干员名称" />
                </DockPanel>
                <ScrollViewer x:Name="FilterScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="等阶" Style="{StaticResource FilterSectionTitle}" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding TierChips}" Focusable="False" Margin="0,0,-4,10">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><ToggleButton Style="{StaticResource TierCellToggle}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,0,0,7">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource MatchModeToggle}" IsChecked="{Binding CoreCovenantMatchAll}" />
                            <TextBlock Text="核心盟约" Style="{StaticResource FilterSectionTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding CoreChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource ChipTemplate}" />
                        <DockPanel Margin="0,7,0,7">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource MatchModeToggle}" IsChecked="{Binding OtherCovenantMatchAll}" />
                            <TextBlock Text="附加盟约" Style="{StaticResource FilterSectionTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding OtherChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource ChipTemplate}" />
                        <TextBlock Text="词条" Style="{StaticResource FilterSectionTitle}" Margin="0,7,0,7" />
                        <ItemsControl ItemsSource="{Binding TraitChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource ChipTemplate}" />
                        <TextBlock Text="触发时机" Style="{StaticResource FilterSectionTitle}" Margin="0,7,0,7" />
                        <ItemsControl ItemsSource="{Binding TimingChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource ChipTemplate}" />
                    </StackPanel>
                </ScrollViewer>
                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{DynamicResource LineBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                <Grid Grid.Row="3">
                    <ListBox x:Name="OperatorsList" ItemsSource="{Binding FilteredOperators}" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="OnOperatorMouseDown" MouseLeftButtonUp="OnOperatorClick" PreviewKeyDown="OnOperatorKeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClickableListBoxItemBase}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row" Height="53" Padding="0,0,10,0" BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}"
                                                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <controls:Avatar DockPanel.Dock="Left" Width="34" Height="34" Margin="10,0,10,0" VerticalAlignment="Center"
                                                     Text="{Binding Name}" Source="{Binding IconPath}" />
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource NumberFontFamily}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Tier, Converter={StaticResource TierToRoman}, StringFormat={}{0} 阶}" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Text" Value="自选" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <ItemsControl ItemsSource="{Binding CoreCovenants}" ItemTemplate="{StaticResource CorePill}" Focusable="False">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding AdditionalCovenants}" ItemTemplate="{StaticResource ExtraPill}" Focusable="False">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:EmptyState Icon="{StaticResource IconOperators}" Title="{Binding EmptyListMessage}" Hint="换个关键词，或点“重置筛选”。">
                        <controls:EmptyState.Style>
                            <Style TargetType="controls:EmptyState">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding FilteredOperators.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </controls:EmptyState.Style>
                    </controls:EmptyState>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
