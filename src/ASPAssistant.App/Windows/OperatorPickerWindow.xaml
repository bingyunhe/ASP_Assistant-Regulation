<!-- Modified for ASP Assistant Arknights on 2026-11-13; see NOTICE. -->
<Window x:Class="ASPAssistant.App.Windows.OperatorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
        xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
        xmlns:local="clr-namespace:ASPAssistant.App.Windows"
        Title="选择干员" Width="840" Height="690" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:TierToRomanConverter x:Key="TierToRoman" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ItemsPanelTemplate x:Key="ChipWrap"><WrapPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ChipGrid3"><UniformGrid Columns="3" /></ItemsPanelTemplate>
        <DataTemplate x:Key="GridChip"><ToggleButton Style="{StaticResource GridChipToggle}" /></DataTemplate>
        <DataTemplate x:Key="WrapChip"><ToggleButton Style="{StaticResource FilterChipToggle}" /></DataTemplate>
        <Style x:Key="RailTitle" TargetType="TextBlock" BasedOn="{StaticResource FilterSectionTitle}">
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="CovPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource PillCornerRadius}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackgroundBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Tag="{StaticResource IconClose}" ToolTip="关闭" Click="OnCancelClick" Style="{StaticResource DialogCloseButton}" />
                    <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Content="─" Click="OnMinimize"
                            ToolTip="最小化" Style="{StaticResource TitleBarButton}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource DialogTitleText}" Text="选择干员" />
                        <TextBlock x:Name="TitleMeta" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TitleMutedBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
                <DockPanel>
                    <Button Style="{StaticResource DialogSecondaryButton}" DockPanel.Dock="Right" Content="清空这个位置" Click="OnClearClick" />
                    <TextBlock x:Name="CountText" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </DockPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Filter rail -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="12,12,12,12">
                        <Button x:Name="ResetFiltersButton" DockPanel.Dock="Bottom" Style="{StaticResource DialogSecondaryButton}" Content="重置筛选"
                                HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnResetFiltersClick" />
                        <ScrollViewer x:Name="FilterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="等阶" Style="{StaticResource RailTitle}" />
                                <ItemsControl ItemsSource="{Binding TierChips}" Focusable="False" Margin="0,0,-4,10">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><ToggleButton Style="{StaticResource TierCellToggle}" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,0,0,7">
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource MatchModeToggle}" IsChecked="{Binding CoreCovenantMatchAll}" />
                                    <TextBlock Text="核心盟约" Style="{StaticResource FilterSectionTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding CoreChips}" Focusable="False" Margin="0,0,-4,6"
                                              ItemsPanel="{StaticResource ChipGrid3}" ItemTemplate="{StaticResource GridChip}" />
                                <DockPanel Margin="0,0,0,7">
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource MatchModeToggle}" IsChecked="{Binding OtherCovenantMatchAll}" />
                                    <TextBlock Text="附加盟约" Style="{StaticResource FilterSectionTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding OtherChips}" Focusable="False" Margin="0,0,-4,6"
                                              ItemsPanel="{StaticResource ChipGrid3}" ItemTemplate="{StaticResource GridChip}" />
                                <Expander x:Name="MoreFilters" Header="词条 · 触发时机" FontSize="11" Margin="0,4,0,0"
                                          Foreground="{DynamicResource TextSecondaryBrush}">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="词条" Style="{StaticResource RailTitle}" />
                                        <ItemsControl ItemsSource="{Binding TraitChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource WrapChip}" />
                                        <TextBlock Text="触发时机" Style="{StaticResource RailTitle}" Margin="0,6,0,7" />
                                        <ItemsControl ItemsSource="{Binding TimingChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource WrapChip}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Search · context · list -->
                <DockPanel Grid.Column="1" Margin="14,12,14,10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ListBox x:Name="ScopeList" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource SegmentedListBox}" SelectionChanged="OnScopeChanged">
                            <ListBoxItem Content="全部" IsSelected="True" />
                            <ListBoxItem x:Name="ScopeTargets" Content="能补目标" />
                        </ListBox>
                        <TextBox x:Name="SearchBox" Style="{StaticResource PickerSearchBox}" Tag="名字或首字母，如 dh"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索干员名称或拼音首字母" PreviewKeyDown="OnOperatorKeyDown" />
                    </DockPanel>
                    <Border x:Name="ContextBar" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,0" MinHeight="32" Visibility="Collapsed"
                            CornerRadius="{DynamicResource RowCornerRadius}" Background="{DynamicResource SectionBackgroundBrush}">
                        <DockPanel>
                            <ItemsControl x:Name="GoalPills" DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="pill" Style="{StaticResource CovPill}" Margin="4,0,0,0" Background="{DynamicResource SuccessTintBrush}"
                                                BorderBrush="{DynamicResource SuccessBorderBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:CovenantIcon Covenant="{Binding Name}" Width="12" Height="12" Margin="0,0,4,0" Opacity="0.85" />
                                                <TextBlock x:Name="text" Text="{Binding Text}" FontSize="10" FontWeight="Bold" LineHeight="18" Foreground="{DynamicResource SuccessTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Reached}" Value="False">
                                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource EliteTintBrush}" />
                                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource EliteBrush}" />
                                                <Setter TargetName="text" Property="Foreground" Value="{DynamicResource EliteBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="放到 " /><Run x:Name="ContextPlace" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" /><Run x:Name="ContextReplace" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ListBox x:Name="OperatorsList" ItemsSource="{Binding FilteredOperators}" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="OnOperatorClick" PreviewKeyDown="OnOperatorKeyDown">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClickableListBoxItemBase}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="row" Height="54" BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}" ClipToBounds="True"
                                                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                        <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border x:Name="bar" DockPanel.Dock="Left" Width="3" Background="{DynamicResource BorderBrush}" />
                                        <controls:Avatar DockPanel.Dock="Left" Width="36" Height="36" Margin="9,0,9,0" VerticalAlignment="Center"
                                                         Text="{Binding Name}" Source="{Binding IconPath}" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <DockPanel>
                                                <TextBlock x:Name="effect" DockPanel.Dock="Right" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center"
                                                           DataContext="{Binding Name, Converter={x:Static local:OperatorPickerWindow.EffectOf}}"
                                                           Text="{Binding Text}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Tier, Converter={StaticResource TierToRoman}, StringFormat={}{0} 阶}" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" FontFamily="{DynamicResource NumberFontFamily}" FontWeight="Bold" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding CoreCovenants}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource CovPill}" Background="{DynamicResource AccentSoftBrush}">
                                                                <TextBlock Text="{Binding}" FontSize="10" LineHeight="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding AdditionalCovenants}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource CovPill}" Background="{DynamicResource SectionBackgroundBrush}">
                                                                <TextBlock Text="{Binding}" FontSize="10" LineHeight="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tier}" Value="4"><Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentSolidBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Tier}" Value="5"><Setter TargetName="bar" Property="Background" Value="{DynamicResource EliteBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Tier}" Value="6"><Setter TargetName="bar" Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Name, Converter={x:Static local:OperatorPickerWindow.EffectUp}}" Value="True">
                                            <Setter TargetName="effect" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                            <Setter TargetName="effect" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <controls:EmptyState x:Name="EmptyHint" Icon="{StaticResource IconOperators}" Title="{Binding EmptyListMessage}" Hint="换个关键词，或点“重置筛选”。"
                                             Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
