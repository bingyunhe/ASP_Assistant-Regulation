<!-- Modified for ASP Assistant Regulation on 2026-11-09; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.TrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:models="clr-namespace:ASPAssistant.Core.Models;assembly=ASPAssistant.Core"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:TrackedOperatorConverter x:Key="TrackedOperator" />
        <converters:TrackedEquipmentConverter x:Key="TrackedEquipment" />
        <converters:TrackedTransformationsConverter x:Key="TrackedTransformations" />
        <DataTemplate DataType="{x:Type models:Equipment}">
            <controls:TrackedEquipmentCard TrackingToggled="OnTrackedEquipmentToggled" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:Operator}">
            <controls:OperatorCard IsTrackingList="True" TrackingToggled="OnTrackedOperatorToggled" />
        </DataTemplate>

        <!-- Tracked name that is not in the operator data -->
        <DataTemplate DataType="{x:Type models:TrackingEntry}">
            <Border Style="{StaticResource ItemCardBorder}" Padding="8,6" Margin="0,0,0,4" CornerRadius="6"
                    ToolTip="当前数据中没有该干员的详情">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Tag="{Binding Name}" Width="25" Height="25" Padding="0"
                            Style="{StaticResource TrackingButton}" Click="OnRemoveTracking" ToolTip="取消追踪" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,10,8,8">
                <!-- Phase switch for the saved lineup currently driving the tracking list -->
                <Border x:Name="LineupSourcePanel" Visibility="Collapsed" Margin="0,0,0,10"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8,6"
                        ToolTip="默认合并四个阶段；切换时期只替换这套阵容加入的追踪干员和装备，其他追踪目标保持不变。">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="追踪阵容" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="LineupSourceName" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <UniformGrid Columns="4" Margin="0,6,0,0">
                            <Button x:Name="EarlyPhaseButton" Content="前期" CommandParameter="前期"
                                    Style="{StaticResource TrackingButton}" Margin="0,0,4,0" Click="OnTrackedPhaseClick" />
                            <Button x:Name="MidPhaseButton" Content="中期" CommandParameter="中期"
                                    Style="{StaticResource TrackingButton}" Margin="0,0,4,0" Click="OnTrackedPhaseClick" />
                            <Button x:Name="LatePhaseButton" Content="后期" CommandParameter="后期"
                                    Style="{StaticResource TrackingButton}" Margin="0,0,4,0" Click="OnTrackedPhaseClick" />
                            <Button x:Name="AllPhasesButton" Content="全部" CommandParameter="全部"
                                    Style="{StaticResource TrackingButton}" Click="OnTrackedPhaseClick" />
                        </UniformGrid>
                        <TextBlock x:Name="EmptyPhaseHint" Text="这个时期还没有选择干员。" FontSize="10" Margin="2,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Summary -->
                <DockPanel Margin="2,0,0,4">
                    <Button DockPanel.Dock="Right" x:Name="ClearAllButton" Content="全部清除" Tag="danger"
                            Style="{StaticResource SmallActionButton}" Click="OnClearAllTracking"
                            ToolTip="清空追踪列表（干员和装备）" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="追踪 " /><Run Text="{Binding TrackedOperators.Count, Mode=OneWay}" FontWeight="Bold"
                        /><Run Text=" 干员 · " /><Run Text="{Binding TrackedEquipment.Count, Mode=OneWay}" FontWeight="Bold"
                        /><Run Text=" 装备" />
                    </TextBlock>
                </DockPanel>
                <TextBlock Text="商店里出现追踪目标时，会在名称上方标出绿色星号。" FontSize="10" TextWrapping="Wrap"
                           Margin="2,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}" />

                <!-- Covenants the tracked operators bring -->
                <StackPanel x:Name="CovenantSection" Visibility="Collapsed" Margin="0,0,0,10">
                    <ContentControl Style="{StaticResource FilterGroupHeader}" Content="目标盟约分布（含计划转职）" />
                    <ItemsControl x:Name="TrackedCovenantChips" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="chip" CornerRadius="10" Padding="7,1" Margin="0,0,5,5" BorderThickness="1"
                                        Background="{DynamicResource NeutralTintBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run x:Name="chipName" Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run
                                             Text="{Binding Count, Mode=OneWay}" FontWeight="Bold" />
                                    </TextBlock>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCore}" Value="True">
                                        <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                        <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Operators -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrackedOperators.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ContentControl Style="{StaticResource FilterGroupHeader}">
                        <TextBlock><Run Text="干员 " /><Run Text="{Binding TrackedOperators.Count, Mode=OneWay}" /></TextBlock>
                    </ContentControl>
                    <ItemsControl ItemsSource="{Binding TrackedOperators}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <ContentControl Focusable="False">
                                        <ContentControl.Content>
                                            <MultiBinding Converter="{StaticResource TrackedOperator}" Mode="OneWay">
                                                <Binding />
                                                <Binding Path="OperatorDatabase"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </ContentControl.Content>
                                    </ContentControl>
                                    <ItemsControl>
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{StaticResource TrackedTransformations}">
                                                <Binding />
                                                <Binding Path="EquipmentRules" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Covenant}" ContentStringFormat="转职：{0} ✕"
                                                        Click="OnClearPlannedTransformation"
                                                        Tag="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        HorizontalAlignment="Left" Margin="4,0,0,6"
                                                        ToolTip="{Binding EquipmentName}" Style="{StaticResource SmallActionButton}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{Binding TransformedCovenant}" ContentStringFormat="清除旧转职：{0}"
                                            Click="OnClearLegacyTransformation" HorizontalAlignment="Left"
                                            ToolTip="此旧转职没有对应装备，可清除后重新设置">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SmallActionButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TransformedCovenant}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TransformedCovenant}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Equipment -->
                <StackPanel Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TrackedEquipment.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ContentControl Style="{StaticResource FilterGroupHeader}">
                        <TextBlock><Run Text="装备 " /><Run Text="{Binding TrackedEquipment.Count, Mode=OneWay}" /></TextBlock>
                    </ContentControl>
                    <ItemsControl ItemsSource="{Binding TrackedEquipment}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Focusable="False">
                                    <ContentControl.Content>
                                        <MultiBinding Converter="{StaticResource TrackedEquipment}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="EquipmentDatabase" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </ContentControl.Content>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28,0" Visibility="Collapsed">
            <TextBlock Text="☆" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="还没有追踪目标" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,4"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="在干员、装备页点 ☆，或在阵容、规划页点“追踪”，商店刷出目标时就会提示。"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
