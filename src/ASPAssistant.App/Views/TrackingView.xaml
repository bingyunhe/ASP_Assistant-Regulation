<!-- Modified for ASP Assistant Arknights on 2026-11-13; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.TrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ASPAssistant.App.Views"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:models="clr-namespace:ASPAssistant.Core.Models;assembly=ASPAssistant.Core"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:TrackedEquipmentConverter x:Key="TrackedEquipment" />
        <converters:LocalPathToImageConverter x:Key="PathToImage" />

        <converters:TrackedTransformationsConverter x:Key="TrackedTransformations" />
        <converters:EquipmentWantersConverter x:Key="EquipmentWanters" />
        <DataTemplate DataType="{x:Type models:Equipment}">
            <controls:EquipmentCell IsTrackingList="True" TrackingToggled="OnTrackedEquipmentToggled" />
        </DataTemplate>

        <!-- Tracked equipment that is not in the data -->
        <DataTemplate DataType="{x:Type models:TrackingEntry}">
            <Border Height="53" Padding="9,0,3,0" Margin="0,0,5,5" CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
                    ToolTip="当前数据中没有该追踪项的详情">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="OnToggleAcquired">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="标记已获取" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                                            <Setter Property="Header" Value="继续追踪" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="22" Height="22" Padding="0" Tag="{StaticResource IconClose}"
                            Style="{StaticResource TitleBarButton}" Click="OnRemoveTracking" ToolTip="取消追踪" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Group marker dot -->
        <Style x:Key="GroupDot" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="{DynamicResource DotCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One tracked operator: avatar ringed in the role color, name, covenants or route stages -->
        <DataTemplate x:Key="TrackedCellTemplate" DataType="{x:Type views:TrackedCell}">
            <Border x:Name="cell" Height="53" Margin="0,0,5,5" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}"
                    ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000" ToolTipService.IsEnabled="{Binding HasDetails}">
                <Border.ToolTip>
                    <ToolTip Placement="Left" Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False" MaxHeight="700">
                        <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="6"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentControl Content="{Binding Operator}" ContentTemplate="{StaticResource OperatorDetailsTemplate}" />
                            </ScrollViewer>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="OnCellToggleAcquired">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="标记已获取" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                                            <Setter Property="Header" Value="继续追踪" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="取消追踪" Click="OnCellRemove" />
                        <MenuItem Header="{Binding TransformedCovenant}" HeaderStringFormat="取消转职（{0}）" Click="OnCellClearTransform"
                                  Visibility="{Binding HasTransform, Converter={StaticResource DetailsBoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Border Style="{StaticResource HoverFadeOverlay}" />
                    <Grid Margin="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:Avatar x:Name="ring" Width="34" Height="34" VerticalAlignment="Center" Margin="2,0,0,0"
                                     Text="{Binding Name}" Source="{Binding IconPath}" Ring="{DynamicResource FinalBrush}" />
                    <StackPanel Grid.Column="1" Margin="8,0,2,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="sub" Text="{Binding Sub}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="remove" Grid.Column="2" Width="20" Height="20" Padding="0" VerticalAlignment="Center"
                            Visibility="Hidden" Tag="{StaticResource IconClose}" Style="{StaticResource TitleBarButton}"
                            Click="OnCellRemove" ToolTip="取消追踪（右键还有更多操作）" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Transition">
                    <Setter TargetName="ring" Property="Ring" Value="{DynamicResource TransitionBrush}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource TransitionTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Past">
                    <Setter TargetName="ring" Property="Ring" Value="{DynamicResource BorderBrush}" />
                    <Setter TargetName="cell" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                    <Setter TargetName="ring" Property="Ring" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                    <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                    <Setter TargetName="cell" Property="Opacity" Value="0.7" />
                </DataTrigger>
                <Trigger SourceName="cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="remove" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TwoColumns">
            <UniformGrid Columns="2" VerticalAlignment="Top" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 购买清单 / 站位 -->
        <ListBox x:Name="TrackingPageList" DockPanel.Dock="Top" Margin="10,10,10,0" Style="{StaticResource SegmentedListBox}"
                 SelectionChanged="OnTrackingPageChanged" SelectedIndex="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
                    <Setter Property="MinHeight" Value="26" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Content="购买清单" />
            <ListBoxItem Content="站位" />
        </ListBox>
        <views:DeployView x:Name="DeployPage" Visibility="Collapsed" />
    <Grid x:Name="ShoppingPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,10,5,8">
                <!-- Terminal level card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="10" Margin="0,0,5,10">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="{DynamicResource RowCornerRadius}"
                                    Background="{DynamicResource AccentSolidBrush}">
                                <TextBlock x:Name="LevelNumber" Text="–" FontFamily="{DynamicResource NumberFontFamily}" FontWeight="Bold" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" />
                            </Border>
                            <ComboBox DockPanel.Dock="Right" Width="64" FontSize="11" VerticalAlignment="Center"
                                      ItemsSource="{Binding TerminalLevelChoices}" SelectedItem="{Binding TerminalLevelChoice, Mode=TwoWay}"
                                      ToolTip="终端等级：默认按商店左侧的升级卡自动识别，识别不对时可以手动指定；自动识别追上手动值后恢复自动">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="choice" Text="{Binding StringFormat={}{0} 级}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="0">
                                                <Setter TargetName="choice" Property="Text" Value="自动" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LevelTitle" Text="终端等级未识别" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LevelDetail" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <!-- Shop HUD: round, funds, upgrade price (read while the shop is open) -->
                        <Border x:Name="EconomyRow" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,6"
                                CornerRadius="{DynamicResource RowCornerRadius}" Background="{DynamicResource SectionBackgroundBrush}"
                                ToolTip="打开商店时自动读取左上角回合、右下角资金和升级卡上方的升级价；读不清时保留上次的数">
                            <DockPanel>
                                <TextBlock x:Name="EconomyMode" DockPanel.Dock="Right" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="回合" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="EconomyRound" Text="–" FontFamily="{DynamicResource NumberFontFamily}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="资金" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="EconomyMoney" Text="–" FontFamily="{DynamicResource NumberFontFamily}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="升级价" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="EconomyCost" Text="–" FontFamily="{DynamicResource NumberFontFamily}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                </UniformGrid>
                            </DockPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="ClearAllButton" Content="全部清除" Tag="danger"
                                        Style="{StaticResource SmallActionButton}" Click="OnClearAllTracking"
                                        ToolTip="清空追踪列表（干员和装备）" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            ToolTip="商店刷出追踪目标时，名称上方的星号颜色：大成 = 保留到最后的干员，过渡 = 道中使用、大成前换掉">
                                    <Border Style="{StaticResource GroupDot}" Background="{DynamicResource FinalBrush}" />
                                    <TextBlock Text="大成" FontSize="11" Margin="5,0,12,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border Style="{StaticResource GroupDot}" Background="{DynamicResource TransitionBrush}" />
                                    <TextBlock Text="过渡" FontSize="11" Margin="5,0,12,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="商店星标颜色" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Covenants the 大成 operators bring -->
                <ItemsControl x:Name="TrackedCovenantChips" Focusable="False" Margin="0,0,0,8" Visibility="Collapsed"
                              ToolTip="大成干员带来的盟约人数（含计划转职，不计过渡干员）">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="chip" CornerRadius="{DynamicResource RowCornerRadius}" Padding="8,2" Margin="0,0,5,5" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="chipName" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource NumberFontFamily}" Foreground="{Binding Foreground, ElementName=chipName}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCore}" Value="True">
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource FinalBrush}" />
                                    <Setter TargetName="chipName" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 大成 -->
                <StackPanel x:Name="FinalSection" Margin="0,0,0,8">
                    <DockPanel Margin="2,0,7,6">
                        <Border Style="{StaticResource GroupDot}" Background="{DynamicResource FinalBrush}" />
                        <TextBlock Text="大成" FontSize="12" FontWeight="Bold" Margin="7,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="FinalCount" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock DockPanel.Dock="Right" Text="保留到最后" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" />
                    </DockPanel>
                    <ItemsControl x:Name="FinalCells" Focusable="False" ItemTemplate="{StaticResource TrackedCellTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" />
                </StackPanel>

                <!-- 过渡 -->
                <StackPanel x:Name="TransitionSection" Margin="0,0,0,8">
                    <DockPanel Margin="2,0,7,6">
                        <Border Style="{StaticResource GroupDot}" Background="{DynamicResource TransitionBrush}" />
                        <TextBlock Text="过渡" FontSize="12" FontWeight="Bold" Margin="7,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TransitionCount" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock DockPanel.Dock="Right" Text="道中用，大成前换掉" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" />
                    </DockPanel>
                    <ItemsControl x:Name="TransitionCells" Focusable="False" ItemTemplate="{StaticResource TrackedCellTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" />
                </StackPanel>

                <!-- 已过 -->
                <StackPanel x:Name="PastSection" Margin="0,0,0,8">
                    <DockPanel Margin="2,0,7,6">
                        <Border Style="{StaticResource GroupDot}" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="已过" FontSize="12" FontWeight="Bold" Margin="7,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="PastCount" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="PastHint" DockPanel.Dock="Right" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" />
                    </DockPanel>
                    <ItemsControl x:Name="PastCells" Focusable="False" ItemTemplate="{StaticResource TrackedCellTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" />
                </StackPanel>

                <!-- Equipment -->
                <StackPanel x:Name="EquipmentSection" Margin="0,0,5,0">
                    <DockPanel Margin="2,0,2,6">
                        <Border Style="{StaticResource GroupDot}" Background="{DynamicResource AccentSolidBrush}" />
                        <TextBlock Text="装备" FontSize="12" FontWeight="Bold" Margin="7,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding TrackedEquipment.Count, StringFormat={}{0} 件}" FontSize="10" Margin="7,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding TrackedEquipment}" Focusable="False" Margin="0,0,-5,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                <ContentControl Focusable="False" Tag="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                    <Setter Property="ToolTip" Value="已获取 · 右键继续追踪" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                    <ContentControl.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="OnToggleAcquired">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="标记已获取" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                                                                <Setter Property="Header" Value="继续追踪" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ContentControl.ContextMenu>
                                    <ContentControl.Content>
                                        <MultiBinding Converter="{StaticResource TrackedEquipment}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="EquipmentDatabase" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </ContentControl.Content>
                                </ContentControl>
                                <!-- 候选 / 优先 from the lineup's candidate equipment; 装备格 equipment has no badge -->
                                <Border x:Name="kindBadge" Width="34" Margin="8,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        BorderThickness="1" CornerRadius="{DynamicResource DotCornerRadius}" Visibility="Collapsed"
                                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                    <Border.ToolTip>
                                        <MultiBinding Converter="{StaticResource EquipmentWanters}">
                                            <Binding />
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </Border.ToolTip>
                                    <TextBlock x:Name="kindText" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding EquipmentKind}" Value="Priority">
                                        <Setter TargetName="kindBadge" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="kindBadge" Property="Background" Value="{DynamicResource EliteTintBrush}" />
                                        <Setter TargetName="kindBadge" Property="BorderBrush" Value="{DynamicResource EliteBrush}" />
                                        <Setter TargetName="kindText" Property="Text" Value="★ 优先" />
                                        <Setter TargetName="kindText" Property="Foreground" Value="{DynamicResource EliteBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EquipmentKind}" Value="Candidate">
                                        <Setter TargetName="kindBadge" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="kindText" Property="Text" Value="候选" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                                        <Setter TargetName="kindBadge" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <controls:EmptyState x:Name="EmptyState" Visibility="Collapsed" Icon="{StaticResource IconTracking}" Title="还没有追踪目标"
                             Hint="在干员、装备页点 ☆，或在阵容、规划页点“追踪”，商店刷出目标时就会提示。" />
    </Grid>
    </DockPanel>
</UserControl>
