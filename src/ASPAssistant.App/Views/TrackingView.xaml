<UserControl x:Class="ASPAssistant.App.Views.TrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:models="clr-namespace:ASPAssistant.Core.Models;assembly=ASPAssistant.Core"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:TrackedOperatorConverter x:Key="TrackedOperator" />
        <converters:TrackedEquipmentConverter x:Key="TrackedEquipment" />
        <DataTemplate DataType="{x:Type models:Operator}">
            <controls:OperatorCard IsTrackingList="True" TrackingToggled="OnTrackedOperatorToggled" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:Equipment}">
            <controls:TrackedEquipmentCard TrackingToggled="OnTrackedEquipmentToggled" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:TrackingEntry}">
            <Border Style="{StaticResource ItemCardBorder}" ToolTip="当前数据中没有该追踪项的详情">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Tag="{Binding Name}"
                            Style="{StaticResource TrackingButton}" Click="OnRemoveTracking" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="当前盟约持有" FontSize="12" FontWeight="Bold" Visibility="Collapsed"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <Border Background="{DynamicResource CardBackgroundBrush}" Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="8" Margin="0,0,0,12">
                <ItemsControl x:Name="CovenantCountsPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>

            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Left" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="追踪中的干员 (" /><Run Text="{Binding TrackedOperators.Count, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="一键清除" FontSize="11"
                        Padding="8,2" Margin="6,0,0,0"
                        HorizontalAlignment="Right"
                        Click="OnClearAllTracking">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
                            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding TrackedOperators}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl>
                            <ContentControl.Content>
                                <MultiBinding Converter="{StaticResource TrackedOperator}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="OperatorDatabase"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </MultiBinding>
                            </ContentControl.Content>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,4">
                <Run Text="追踪中的装备 (" /><Run Text="{Binding TrackedEquipment.Count, Mode=OneWay}" /><Run Text=")" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding TrackedEquipment}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl>
                            <ContentControl.Content>
                                <MultiBinding Converter="{StaticResource TrackedEquipment}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="EquipmentDatabase"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </MultiBinding>
                            </ContentControl.Content>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="游戏状态（实时 OCR）" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,4" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="8">
                <StackPanel DataContext="{Binding GameState}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                            <Run Text="回合: " /><Run Text="{Binding RoundDisplay, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="16,0,0,0">
                            <Run Text="升本: " /><Run Text="{Binding UpgradeStateDisplay, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TrackingAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TrackingBrush}"
                                           FontSize="12" FontWeight="Bold" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
