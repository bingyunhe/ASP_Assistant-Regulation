<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.TrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ASPAssistant.App.Views"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:models="clr-namespace:ASPAssistant.Core.Models;assembly=ASPAssistant.Core"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:TrackedEquipmentConverter x:Key="TrackedEquipment" />
        <converters:LocalPathToImageConverter x:Key="PathToImage" />

        <converters:TrackedTransformationsConverter x:Key="TrackedTransformations" />
        <DataTemplate DataType="{x:Type models:Equipment}">
            <controls:EquipmentCell IsTrackingList="True" TrackingToggled="OnTrackedEquipmentToggled"
                                   IsAcquired="{Binding Tag.IsAcquired, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                   AcquisitionRequested="OnTrackedEquipmentAcquired" />
        </DataTemplate>

        <!-- Tracked equipment that is not in the data -->
        <DataTemplate DataType="{x:Type models:TrackingEntry}">
            <Border Height="53" Padding="9,0,3,0" Margin="0,0,5,5" CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
                    ToolTip="当前数据中没有该追踪项的详情">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="22" Height="22" Padding="0" Tag="{StaticResource IconClose}"
                            Style="{StaticResource RowIconButton}" Click="OnRemoveTracking" ToolTip="取消追踪" />
                    <Button DockPanel.Dock="Right" Click="OnToggleAcquired" Margin="0,0,3,0" Padding="6,3" FontSize="11" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SmallActionButton}">
                                <Setter Property="Content" Value="获取" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                                        <Setter Property="Content" Value="已获取" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Group marker dot -->
        <Style x:Key="GroupDot" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="{DynamicResource DotCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One tracked operator: avatar ringed in the role color, name, covenants or route stages -->
        <DataTemplate x:Key="TrackedCellTemplate" DataType="{x:Type views:TrackedCell}">
            <Border x:Name="cell" Height="53" Margin="0,0,5,5" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}"
                    ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000" ToolTipService.IsEnabled="{Binding HasDetails}">
                <Border.ToolTip>
                    <ToolTip Placement="Left" Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False" MaxHeight="700">
                        <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="6"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentControl Content="{Binding Operator}" ContentTemplate="{StaticResource OperatorDetailsTemplate}" />
                            </ScrollViewer>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="更新获取 / 精锐状态" Click="OnCellOpenStatus" />
                        <MenuItem Header="取消追踪" Click="OnCellRemove" />
                        <MenuItem Header="{Binding TransformedCovenant}" HeaderStringFormat="取消转职（{0}）" Click="OnCellClearTransform"
                                  Visibility="{Binding HasTransform, Converter={StaticResource DetailsBoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Border Style="{StaticResource HoverFadeOverlay}" />
                    <Grid Margin="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:Avatar x:Name="ring" Width="34" Height="34" VerticalAlignment="Center" Margin="2,0,0,0"
                                     Text="{Binding Name}" Source="{Binding IconPath}" Ring="{DynamicResource FinalBrush}" />
                    <StackPanel Grid.Column="1" Margin="8,0,2,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="sub" Text="{Binding Sub}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Progress}" Click="OnCellOpenStatus" Margin="0,0,3,0" Padding="6,3" FontSize="11" Style="{StaticResource SmallActionButton}" ToolTip="前往干员状态修改获取与精锐" />
                    <Button x:Name="remove" Width="20" Height="20" Padding="0" VerticalAlignment="Center"
                            Visibility="Hidden" Tag="{StaticResource IconClose}" Style="{StaticResource TitleBarButton}"
                            Click="OnCellRemove" ToolTip="取消追踪（右键还有更多操作）" />
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Transition">
                    <Setter TargetName="ring" Property="Ring" Value="{DynamicResource TransitionBrush}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource TransitionTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Past">
                    <Setter TargetName="ring" Property="Ring" Value="{DynamicResource BorderBrush}" />
                    <Setter TargetName="cell" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                    <Setter TargetName="ring" Property="Ring" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                    <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                    <Setter TargetName="cell" Property="Opacity" Value="0.7" />
                </DataTrigger>
                <Trigger SourceName="cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="remove" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TwoColumns">
            <StackPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 购买清单 / 站位 / 地图模拟 -->
        <ListBox x:Name="TrackingPageList" DockPanel.Dock="Top" Margin="10,10,10,0" Style="{StaticResource SegmentedListBox}"
                 SelectionChanged="OnTrackingPageChanged" SelectedIndex="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
                    <Setter Property="MinHeight" Value="26" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Content="购买清单" />
            <ListBoxItem Content="干员状态" />
            <ListBoxItem Content="地图模拟" />
        </ListBox>
        <Grid>
        <views:DeployView x:Name="DeployPage" Visibility="Collapsed" />
    <Grid x:Name="ShoppingPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,10,5,8">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="9" Margin="0,0,5,8">
                    <StackPanel>
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="66" FontSize="11" ItemsSource="{Binding TerminalLevelChoices}"
                                      SelectedItem="{Binding TerminalLevelChoice, Mode=TwoWay}" ToolTip="自动识别；可手动指定，自动识别追上后恢复自动">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock x:Name="choice" Text="{Binding StringFormat={}{0} 级}" />
                                    <DataTemplate.Triggers><DataTrigger Binding="{Binding}" Value="0"><Setter TargetName="choice" Property="Text" Value="自动" /></DataTrigger></DataTemplate.Triggers>
                                </DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="LevelTitle" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </DockPanel>
                        <TextBlock x:Name="LevelDetail" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" x:Name="ClearAllButton" Content="清空追踪" Tag="danger" Style="{StaticResource SmallActionButton}"
                                    Click="OnClearAllTracking" ToolTip="清空追踪目标，保留已拥有、精锐和数量" />
                            <TextBlock x:Name="ProgressSummary" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <ListBox x:Name="CompletionFilterList" SelectedIndex="0" SelectionChanged="OnCompletionFilterChanged" Style="{StaticResource SegmentedListBox}" Margin="0,0,5,8">
                    <ListBoxItem Content="待完成" /><ListBoxItem Content="已完成" /><ListBoxItem Content="全部" />
                </ListBox>
                <TextBlock Text="目标盟约 · 大成干员合计" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,5,4" />
                <!-- Covenants the 大成 operators bring -->
                <ItemsControl x:Name="TrackedCovenantChips" Focusable="False" Margin="0,0,0,8" Visibility="Collapsed"
                              ToolTip="目标大成干员带来的盟约人数，包含已完成干员与计划转职，不计过渡干员">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="chip" CornerRadius="{DynamicResource RowCornerRadius}" Padding="8,2" Margin="0,0,5,5" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="chipName" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource NumberFontFamily}" Foreground="{Binding Foreground, ElementName=chipName}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCore}" Value="True">
                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource FinalBrush}" />
                                    <Setter TargetName="chipName" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 大成 -->
                <StackPanel x:Name="FinalSection" Margin="0,0,0,8">
                    <DockPanel Margin="2,0,7,6">
                        <Button x:Name="FinalToggle" DockPanel.Dock="Right" Content="收起" Tag="{Binding ElementName=FinalCells}"
                                Click="OnToggleGroup" Style="{StaticResource SmallActionButton}" Padding="6,0" Margin="6,0,0,0" />
                        <Border Style="{StaticResource GroupDot}" Background="{DynamicResource FinalBrush}" />
                        <TextBlock Text="大成干员" FontSize="12" FontWeight="Bold" Margin="7,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="FinalCount" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock DockPanel.Dock="Right" Text="保留到最后" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" />
                    </DockPanel>
                    <ItemsControl x:Name="FinalCells" Focusable="False" ItemTemplate="{StaticResource TrackedCellTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" />
                </StackPanel>

                <!-- 过渡 -->
                <StackPanel x:Name="TransitionSection" Margin="0,0,0,8">
                    <DockPanel Margin="2,0,7,6">
                        <Button x:Name="TransitionToggle" DockPanel.Dock="Right" Content="收起" Tag="{Binding ElementName=TransitionCells}"
                                Click="OnToggleGroup" Style="{StaticResource SmallActionButton}" Padding="6,0" Margin="6,0,0,0" />
                        <Border Style="{StaticResource GroupDot}" Background="{DynamicResource TransitionBrush}" />
                        <TextBlock Text="过渡干员" FontSize="12" FontWeight="Bold" Margin="7,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TransitionCount" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock DockPanel.Dock="Right" Text="道中用，大成前换掉" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" />
                    </DockPanel>
                    <ItemsControl x:Name="TransitionCells" Focusable="False" ItemTemplate="{StaticResource TrackedCellTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" />
                </StackPanel>

                <!-- 已过 -->
                <StackPanel x:Name="PastSection" Margin="0,0,5,8">
                <Button x:Name="PastToggle" Content="▸ 已过期的过渡干员" Click="OnTogglePast" HorizontalAlignment="Left" Style="{StaticResource SmallActionButton}" Margin="0,0,0,5" />
                <StackPanel x:Name="PastBody" Visibility="Collapsed">
                    <DockPanel Margin="2,0,7,6">
                        <Border Style="{StaticResource GroupDot}" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="已过" FontSize="12" FontWeight="Bold" Margin="7,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="PastCount" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="PastHint" DockPanel.Dock="Right" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" />
                    </DockPanel>
                    <ItemsControl x:Name="PastCells" Focusable="False" ItemTemplate="{StaticResource TrackedCellTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" />
                </StackPanel>
                </StackPanel>

                <!-- Equipment -->
                <StackPanel x:Name="EquipmentSection" Margin="0,0,5,0">
                    <DockPanel Margin="2,0,2,6">
                        <Border Style="{StaticResource GroupDot}" Background="{DynamicResource AccentSolidBrush}" />
                        <TextBlock Text="装备" FontSize="12" FontWeight="Bold" Margin="7,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="EquipmentCount" FontSize="10" Margin="7,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" />
                    </DockPanel>
                    <ItemsControl x:Name="EquipmentCells" Focusable="False" Margin="0,0,-5,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Focusable="False" Tag="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAcquired}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                    <Setter Property="ToolTip" Value="已获取" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                    <ContentControl.Content>
                                        <MultiBinding Converter="{StaticResource TrackedEquipment}" Mode="OneWay">
                                            <Binding />
                                            <Binding Path="EquipmentDatabase" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </ContentControl.Content>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <controls:EmptyState x:Name="EmptyState" Visibility="Collapsed" Margin="0,200,0,0" IsHitTestVisible="False" Icon="{StaticResource IconTracking}" Title="还没有追踪目标"
                             Hint="在干员、装备页点 ☆，或在阵容、规划页点“追踪”，商店刷出目标时就会提示。" />
    </Grid>
        </Grid>
    </DockPanel>
</UserControl>
