<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.OperatorBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:viewModels="clr-namespace:ASPAssistant.Core.ViewModels;assembly=ASPAssistant.Core"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <CollectionViewSource x:Key="OperatorsByTier" Source="{Binding FilteredOperators}">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="Tier" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Tier" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <ItemsPanelTemplate x:Key="ChipWrap"><WrapPanel /></ItemsPanelTemplate>
        <DataTemplate x:Key="ChipTemplate">
            <ToggleButton Style="{StaticResource FilterChipToggle}" />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,0">
            <ListBox x:Name="OperatorSourceList" HorizontalAlignment="Left" Style="{StaticResource SegmentedListBox}"
                     SelectedValuePath="Tag" SelectedValue="{Binding SelectedOperatorSource}">
                <ListBoxItem Content="默认干员" Tag="{x:Static viewModels:OperatorSourceFilter.Default}" />
                <ListBoxItem Content="自选干员" Tag="{x:Static viewModels:OperatorSourceFilter.Custom}" />
            </ListBox>
            <Button x:Name="ManageCustomOperatorsButton" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Click="OnManageCustomOperators"
                    ToolTip="从候选目录中选择最多 12 名干员，暂不区分五本、六本">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallActionButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding SelectedOperatorSource}" Value="{x:Static viewModels:OperatorSourceFilter.Custom}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger></Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding CustomSelectionCount, StringFormat=管理自选 · {0}/12}" />
            </Button>
        </StackPanel>
        <!-- Run banner: this run's bans · 重新录入 · ⋯ (只看本局盟约 / 清除录入 / 清除本局 Ban 位) -->
        <Border DockPanel.Dock="Top" Margin="10,10,10,0" Padding="10,8" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="ManualScanButton" Content="截屏录入" Height="28" Padding="10,0"
                            Style="{StaticResource SmallActionButton}"
                            ToolTip="打开游戏内的本局信息页后点击，录入 Ban 位、盟约和敌人（Ctrl+Shift+/）"
                            Click="OnManualScanClicked" />
                    <Button x:Name="RunMenuButton" Style="{StaticResource MoreButton}" Margin="4,0,0,0"
                            AutomationProperties.Name="更多本局操作" ToolTip="更多本局操作" Click="OnRunMenuClicked">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem x:Name="OnlyCurrentRunToggle" Header="只看本局盟约" IsCheckable="True"
                                          IsChecked="{Binding OnlyCurrentRun}" IsEnabled="{Binding HasRunInfo}"
                                          ToolTip="筛选里只列出本局录入的盟约" />
                                <Separator />
                                <MenuItem x:Name="ClearHighlightsButton" Header="清除录入" Click="OnClearHighlightsClicked"
                                          ToolTip="清除本局盟约录入及规划限制" />
                                <MenuItem x:Name="ClearBansButton" Header="清除本局 Ban 位" Foreground="{DynamicResource DangerBrush}" Click="OnClearBansClicked" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="本局 Ban 位" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="BanBannerMeta" Text="未录入" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ItemsControl x:Name="BanCovenantPills" Margin="0,6,0,0" Focusable="False" Visibility="Collapsed" ClipToBounds="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource PillCornerRadius}" Padding="6,1" Margin="0,0,4,2" BorderThickness="1"
                                        Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBorderBrush}">
                                    <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ManualScanStatusText" FontSize="10" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search -->
        <Border DockPanel.Dock="Top" Margin="10,10,10,8" Height="32" Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}" Padding="9,0">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Grid>
                    <TextBlock Text="搜索干员名称" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0" Padding="0" FontSize="12" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource AccentBrush}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 全部 / 本局可用 / 不可用 · 筛选 -->
        <DockPanel DockPanel.Dock="Top" Margin="10,0,10,0" LastChildFill="False">
            <ToggleButton x:Name="FilterToggle" DockPanel.Dock="Right" Style="{StaticResource FilterTogglePill}" Content="筛选" />
            <ListBox x:Name="AvailabilityFilterList" DockPanel.Dock="Left" Style="{StaticResource SegmentedListBox}"
                     SelectionChanged="OnAvailabilityFilterChanged">
                <ListBoxItem Content="全部" />
                <ListBoxItem Content="本局可用" />
                <ListBoxItem Content="不可用" />
            </ListBox>
        </DockPanel>

        <!-- Collapsed: chosen conditions as removable tags -->
        <ItemsControl x:Name="FilterTagsControl" DockPanel.Dock="Top" Margin="10,8,10,0" Focusable="False"
                      ItemsSource="{Binding ActiveChips}" ItemTemplate="{StaticResource FilterTagTemplate}" ItemsPanel="{StaticResource ChipWrap}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveChips}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=FilterToggle}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>

        <!-- Expanded: the filter card -->
        <Border x:Name="FilterContentPanel" DockPanel.Dock="Top" Margin="10,8,10,2" Style="{StaticResource FilterCard}"
                Visibility="{Binding IsChecked, ElementName=FilterToggle, Converter={StaticResource DetailsBoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430">
                <StackPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedOperatorSource}" Value="{x:Static viewModels:OperatorSourceFilter.Custom}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    <TextBlock Text="等阶" Style="{StaticResource FilterSectionTitle}" Margin="0,0,0,7" />
                    <ItemsControl ItemsSource="{Binding TierChips}" Focusable="False" Margin="0,0,-4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ToggleButton Style="{StaticResource TierCellToggle}" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Margin="0,12" Background="{DynamicResource LineBrush}" />

                    <DockPanel Margin="0,0,0,7">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource MatchModeToggle}" IsChecked="{Binding CoreCovenantMatchAll}" />
                        <TextBlock Text="核心盟约" Style="{StaticResource FilterSectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding CoreChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource ChipTemplate}" />

                    <DockPanel Margin="0,7,0,7">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource MatchModeToggle}" IsChecked="{Binding OtherCovenantMatchAll}" />
                        <TextBlock Text="附加盟约" Style="{StaticResource FilterSectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding OtherChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource ChipTemplate}" />

                    <Border Height="1" Margin="0,7,0,12" Background="{DynamicResource LineBrush}" />

                    <TextBlock Text="词条" Style="{StaticResource FilterSectionTitle}" Margin="0,0,0,7" />
                    <ItemsControl ItemsSource="{Binding TraitChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource ChipTemplate}" />
                    <TextBlock Text="触发时机" Style="{StaticResource FilterSectionTitle}" Margin="0,7,0,7" />
                    <ItemsControl ItemsSource="{Binding TimingChips}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource ChipTemplate}" />

                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,7,0,0" Padding="0,10,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="收起" Height="30" Padding="14,0" Margin="6,0,0,0" Tag="accent"
                                    Style="{StaticResource SmallActionButton}" Click="OnCollapseFiltersClicked" />
                            <Button x:Name="ResetFiltersButton" DockPanel.Dock="Right" Content="重置" Height="30" Padding="12,0"
                                    Style="{StaticResource SmallActionButton}" ToolTip="把所有筛选恢复为默认" Click="OnResetFiltersClicked" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="符合条件 " /><Run Text="{Binding MatchedCount, Mode=OneWay}" FontWeight="Bold" FontSize="13"
                                     FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text=" 名" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Operator list: single column, grouped by tier, virtualized (only rows on screen are built) -->
        <Grid Margin="0,4,0,0">
            <ItemsControl x:Name="OperatorListControl" ItemsSource="{Binding Source={StaticResource OperatorsByTier}}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False">
                            <ItemsPresenter Margin="10,0,5,10" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TierGroupHeader}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedOperatorSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Value="{x:Static viewModels:OperatorSourceFilter.Custom}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger></Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:OperatorCard TrackingToggled="OnOperatorTrackingToggled"
                                               controls:OperatorCard.BanToggled="OnOperatorBanToggled" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:EmptyState x:Name="EmptyFilterText" Icon="{StaticResource IconOperators}" Title="{Binding EmptyListMessage}">
                <controls:EmptyState.Style>
                    <Style TargetType="controls:EmptyState">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Hint" Value="换个关键词，或在筛选里点“重置”。" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredOperators.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding SelectedOperatorSource}" Value="{x:Static viewModels:OperatorSourceFilter.Custom}" />
                                    <Condition Binding="{Binding CustomSelectionCount}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Hint" Value="点上方“管理自选”，选择最多 12 名干员。" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyState.Style>
            </controls:EmptyState>
        </Grid>
    </DockPanel>
</UserControl>
