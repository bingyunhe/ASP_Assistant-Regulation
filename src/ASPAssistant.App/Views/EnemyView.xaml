<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.EnemyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:LocalPathToImageConverter x:Key="LocalPathToImage" />
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="10,6,10,10">
            <TextBlock x:Name="RecognitionStatusText" Text="{Binding RecognitionStatus}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="2,0,0,6" />
            <Button x:Name="RecognizeEnemyButton" Content="识别本局敌人" Height="34" HorizontalAlignment="Stretch"
                    Style="{StaticResource SmallActionButton}" FontSize="12"
                    IsEnabled="{Binding CanRecognize}" Click="OnRecognizeEnemy"
                    ToolTip="打开游戏内的本局信息页后点击" />
        </StackPanel>
    <Grid>
    <controls:EmptyState Icon="{StaticResource IconEnemy}" Title="还没有识别本局敌人"
                         Hint="开局时打开游戏内的本局信息页，再点下方“识别本局敌人”，首领和特训敌人会显示在这里。">
        <controls:EmptyState.Style>
            <Style TargetType="controls:EmptyState">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding BossName}" Value="" />
                            <Condition Binding="{Binding EnemyTypes.Count}" Value="0" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </controls:EmptyState.Style>
    </controls:EmptyState>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
        <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding BossName}" Value="" />
                            <Condition Binding="{Binding EnemyTypes.Count}" Value="0" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Style>
        <StackPanel Margin="10,10,10,4">
            <ItemsControl ItemsSource="{Binding UnmatchedEntries}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="识别文字（可展开核对）" Foreground="{DynamicResource TextSecondaryBrush}"
                      FontSize="11" Margin="0,0,0,8">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RawTexts.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <ItemsControl ItemsSource="{Binding RawTexts}" Margin="4,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
            <!-- Section: 首领 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                <Border Width="3" Height="14" CornerRadius="{DynamicResource DotCornerRadius}"
                        Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                <TextBlock Text="首领" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
            <Border Style="{StaticResource ItemCardBorder}" Padding="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Boss portrait: always occupies space; placeholder when no asset -->
                    <Grid Grid.Column="0" Margin="12,12,0,12" Width="64" Height="64" VerticalAlignment="Top">
                        <controls:Avatar Text="首" Source="{Binding AvatarPath}" Ring="{DynamicResource DangerBorderBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,12,12,12">
                        <!-- Meta chips: SP index + damage type (each chip hides independently) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Padding="6,2" Margin="0,0,6,0"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TraitTagBorder}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BossIndex}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BossIndex}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <Border Padding="6,2"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TraitTagBorder}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BossDamageSummary}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BossDamageSummary}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding BossName}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BossName}" Value="">
                                            <Setter Property="Text" Value="等待识别首领…" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="FontSize" Value="13" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding BossDescription}"
                                   FontSize="11" LineHeight="17"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BossDescription}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- 首领技能 -->
            <StackPanel Margin="0,2,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BossAbilities.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                    <Border Width="3" Height="14" CornerRadius="{DynamicResource DotCornerRadius}"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                            VerticalAlignment="Center" />
                    <TextBlock Text="首领技能" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <Border Style="{StaticResource ItemCardBorder}" Padding="10,10" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding BossAbilities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Left" Width="5" Height="5" CornerRadius="{DynamicResource DotCornerRadius}"
                                            Background="{DynamicResource DangerBrush}"
                                            Margin="0,6,10,0" VerticalAlignment="Top" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Path=.}"
                                               FontSize="11" LineHeight="17"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
            <!-- 特训敌人 -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,6" VerticalAlignment="Center">
                <Border Width="3" Height="14" CornerRadius="{DynamicResource DotCornerRadius}"
                        Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                <TextBlock Text="特训敌人" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
            <Border Padding="14,12" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ItemCardBorder}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EnemyTypes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="识别到关卡信息后，将在此显示特训敌人种类与可能登场的小怪。"
                           FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LineHeight="16" />
            </Border>
            <ItemsControl ItemsSource="{Binding EnemyTypeDetails}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCardBorder}" Padding="10,10" Margin="0,0,0,8">
                            <!-- Type header -->
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeCode}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Opacity="0.85"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TypeCode}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Avatar Width="32" Height="32" Margin="0,0,10,0" Text="{Binding TypeName}" Source="{Binding TypeIconPath}" />
                                        <TextBlock Text="{Binding TypeName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <!-- 前半段 -->
                                <StackPanel Margin="0,0,0,2">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FirstHalfVariants.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="前半段" FontSize="11" Margin="1,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding FirstHalfVariants}" Margin="0,0,-5,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" VerticalAlignment="Top" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="36" Margin="0,0,5,5" Padding="7,0" CornerRadius="{DynamicResource RowCornerRadius}"
                                                        Background="{DynamicResource SectionBackgroundBrush}"
                                                        ToolTipService.InitialShowDelay="120" ToolTip="{Binding TooltipName}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:Avatar Width="24" Height="24" Small="True" VerticalAlignment="Center"
                                                                         Text="{Binding TooltipName}" Source="{Binding IconPath}" />
                                                        <TextBlock Text="{Binding TooltipName}" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="96" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- 后半段 -->
                                <StackPanel Margin="0,4,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SecondHalfVariants.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="后半段" FontSize="11" Margin="1,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding SecondHalfVariants}" Margin="0,0,-5,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" VerticalAlignment="Top" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="36" Margin="0,0,5,5" Padding="7,0" CornerRadius="{DynamicResource RowCornerRadius}"
                                                        Background="{DynamicResource SectionBackgroundBrush}"
                                                        ToolTipService.InitialShowDelay="120" ToolTip="{Binding TooltipName}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:Avatar Width="24" Height="24" Small="True" VerticalAlignment="Center"
                                                                         Text="{Binding TooltipName}" Source="{Binding IconPath}" />
                                                        <TextBlock Text="{Binding TooltipName}" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="96" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </Grid>
    </DockPanel>
</UserControl>
