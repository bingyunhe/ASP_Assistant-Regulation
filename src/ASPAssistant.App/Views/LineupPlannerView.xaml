<UserControl x:Class="ASPAssistant.App.Views.LineupPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             xmlns:vm="clr-namespace:ASPAssistant.Core.ViewModels;assembly=ASPAssistant.Core"
             x:Name="Root"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- Small text-only link button -->
        <Style x:Key="PlannerLinkButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="cp" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cp" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented step switch -->
        <Style x:Key="PlannerSegmentButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill buttons on result cards / footer -->
        <Style x:Key="PlannerGhostButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlannerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PlannerGhostButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PrimaryActionHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ⅰ / Ⅱ level buttons on a covenant tile. Tag="On" marks the active level. -->
        <Style x:Key="PlannerLevelButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlannerSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="PlannerHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ── Hover details ─────────────────────────────────────────────── -->
        <!-- Operator details (same 普通 / 精锐 cards as the 干员 tab). Set Tag to the Operator on the hovered element. -->
        <ToolTip x:Key="OperatorDetailsToolTip" x:Shared="False" Placement="Left" HorizontalOffset="-8"
                 Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False" MaxHeight="700"
                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="10" Padding="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Border CornerRadius="6" Padding="8,4" Margin="0,0,0,6" Background="{DynamicResource EliteTintBrush}"
                            BorderBrush="{DynamicResource EliteBrush}" BorderThickness="1"
                            Visibility="{Binding PlacementTarget.DataContext.HasExtraInfo, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding PlacementTarget.DataContext.ExtraInfo, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource EliteBrush}" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperatorDetailsTemplate}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </ToolTip>

        <!-- Covenant details: requirements, ban note and every operator holding it -->
        <DataTemplate x:Key="CovenantDetailsTemplate" DataType="{x:Type vm:PlannerCovenantItem}">
            <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="10" Padding="12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="300">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" VerticalAlignment="Center"
                                Background="{DynamicResource NeutralTintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding TypeText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Border CornerRadius="8" Padding="7,1" Margin="0,0,5,0" BorderThickness="1"
                                Background="{DynamicResource AvailableTintBrush}" BorderBrush="{DynamicResource AvailableBrush}"
                                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="本局可用" FontSize="10" Foreground="{DynamicResource AvailableBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="7,1" Margin="0,0,5,0" BorderThickness="1"
                                Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                Visibility="{Binding IsBanned, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="本局被 Ban" FontSize="10" Foreground="{DynamicResource DangerBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="7,1" BorderThickness="1"
                                Background="{DynamicResource EliteTintBrush}" BorderBrush="{DynamicResource EliteBrush}"
                                Visibility="{Binding CanTransformInto, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="可作为转职目标" FontSize="10" Foreground="{DynamicResource EliteBrush}" />
                        </Border>
                    </WrapPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="24" Height="20" CornerRadius="5" Margin="0,0,8,4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                            <TextBlock Text="Ⅰ" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding FirstRequirement}" FontSize="12" Margin="0,1,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Grid.Row="1" Width="24" Height="20" CornerRadius="5" Margin="0,0,8,0" Background="{DynamicResource EliteBrush}" VerticalAlignment="Top">
                            <TextBlock Text="Ⅱ" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SecondRequirement}" FontSize="12" Margin="0,1,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <!-- In-game effects: base effect first, then <condition> rows -->
                    <ItemsControl ItemsSource="{Binding Effects}" Focusable="False" Margin="0,4,0,2"
                                  Visibility="{Binding HasEffects, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,7">
                                    <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,1" Margin="0,0,0,3"
                                            Background="{DynamicResource EliteTintBrush}" BorderBrush="{DynamicResource EliteBrush}" BorderThickness="1"
                                            Visibility="{Binding HasCondition, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Condition}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource EliteBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Text}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding BanNote}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"
                               Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding HasBanNote, Converter={StaticResource BoolToVis}}" />
                    <Rectangle Height="1" Margin="0,4,0,8" Fill="{DynamicResource BorderBrush}" />
                    <TextBlock Text="{Binding MemberSummary}" FontSize="10" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Members}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlannerCovenantMember}">
                                <StackPanel x:Name="member" Width="48" Margin="0,0,0,6">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Fill="{DynamicResource SectionBackgroundBrush}" />
                                        <TextBlock Text="{Binding Initial}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock x:Name="memberName" Text="{Binding Name}" FontSize="9" TextAlignment="Center" Margin="1,2,1,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                        <Setter TargetName="member" Property="Opacity" Value="0.35" />
                                        <Setter TargetName="memberName" Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One covenant tile -->
        <DataTemplate x:Key="CovenantTileTemplate" DataType="{x:Type vm:PlannerCovenantItem}">
            <Border x:Name="tile" Height="34" Margin="0,0,5,5" CornerRadius="8" BorderThickness="1" Padding="7,0,5,0"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    ToolTipService.InitialShowDelay="350" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="60000">
                <Border.ToolTip>
                    <ToolTip Placement="Left" HorizontalOffset="-8" Background="Transparent" BorderThickness="0" Padding="0"
                             HasDropShadow="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CovenantDetailsTemplate}" />
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="dot" Width="5" Height="5" Margin="0,0,5,0" Fill="{DynamicResource AccentBrush}"
                             Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="name" Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border x:Name="banTag" Grid.Column="2" Visibility="Collapsed" BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="4,0" VerticalAlignment="Center">
                        <TextBlock Text="禁" FontSize="10" Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                    <Button x:Name="lv1" Grid.Column="3" Content="Ⅰ" Style="{StaticResource PlannerLevelButton}"
                            Command="{Binding ToggleLevel1Command}" />
                    <Button x:Name="lv2" Grid.Column="4" Content="{Binding SecondLabel}" Style="{StaticResource PlannerLevelButton}"
                            Command="{Binding ToggleLevel2Command}" IsEnabled="{Binding HasSecond}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLevel1}" Value="True">
                    <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="tile" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="name" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="lv1" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="lv1" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="lv1" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLevel2}" Value="True">
                    <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource EliteBrush}" />
                    <Setter TargetName="tile" Property="Background" Value="{DynamicResource EliteTintBrush}" />
                    <Setter TargetName="name" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="lv2" Property="Background" Value="{DynamicResource EliteBrush}" />
                    <Setter TargetName="lv2" Property="BorderBrush" Value="{DynamicResource EliteBrush}" />
                    <Setter TargetName="lv2" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBanned}" Value="True">
                    <Setter TargetName="banTag" Property="Visibility" Value="Visible" />
                    <Setter TargetName="banTag" Property="Margin" Value="0,0,2,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                    <Setter TargetName="tile" Property="Opacity" Value="0.5" />
                    <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="name" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter TargetName="dot" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="lv1" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="lv2" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="CovenantContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
        </Style>

        <ItemsPanelTemplate x:Key="TwoColumnPanel">
            <UniformGrid Columns="2" Margin="0,0,-5,0" />
        </ItemsPanelTemplate>

        <!-- Operator avatar on a result card -->
        <DataTemplate x:Key="PlannedOperatorTemplate" DataType="{x:Type vm:PlannerOperatorItem}">
            <StackPanel Margin="0,0,0,6" Background="Transparent" Tag="{Binding Operator}"
                        ToolTip="{StaticResource OperatorDetailsToolTip}" ToolTipService.IsEnabled="{Binding HasDetails}"
                        ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowDuration="60000">
                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                    <Ellipse x:Name="plate" Fill="{DynamicResource SectionBackgroundBrush}" />
                    <TextBlock x:Name="initial" Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Ellipse x:Name="photo">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="ring" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2" />
                    <Border x:Name="lockBadge" Visibility="Collapsed" Width="15" Height="15" CornerRadius="8"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                            Background="{DynamicResource AccentBrush}">
                        <Path Width="7" Height="8" Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}"
                              Data="M2,5 L2,3 A3,3 0 0 1 8,3 L8,5 L9,5 L9,11 L1,11 L1,5 Z M3.5,5 L6.5,5 L6.5,3 A1.5,1.5 0 0 0 3.5,3 Z" />
                    </Border>
                    <Border x:Name="harmonyBadge" Visibility="Collapsed" CornerRadius="7" Padding="3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-3"
                            Background="{DynamicResource SuccessBrush}">
                        <TextBlock Text="+1" FontSize="9" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Grid>
                <TextBlock x:Name="opName" Text="{Binding Name}" FontSize="11" TextAlignment="Center" Margin="2,2,2,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="sub" Text="{Binding Sub}" FontSize="9" TextAlignment="Center" Margin="2,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="lockBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHarmony}" Value="True">
                    <Setter TargetName="harmonyBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTransformed}" Value="True">
                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource EliteBrush}" />
                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource EliteBrush}" />
                    <Setter TargetName="sub" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFree}" Value="True">
                    <Setter TargetName="plate" Property="Fill" Value="Transparent" />
                    <Setter TargetName="photo" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ring" Property="StrokeDashArray" Value="3 2" />
                    <Setter TargetName="ring" Property="StrokeThickness" Value="1" />
                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter TargetName="opName" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Goal / covenant pill (result cards and saved-lineup board) -->
        <DataTemplate x:Key="GoalPillTemplate" DataType="{x:Type vm:PlannerGoalPill}">
            <Border x:Name="pill" CornerRadius="10" Padding="7,1" Margin="0,0,5,4" BorderThickness="1"
                    Background="{DynamicResource SuccessTintBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}">
                <TextBlock x:Name="pillText" Text="{Binding Text}" FontSize="10" Foreground="{DynamicResource SuccessTextBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsManual}" Value="True">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarningTintBrush}" />
                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource WarningMutedBrush}" />
                    <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Compact avatar on the saved-lineup board -->
        <DataTemplate x:Key="SavedLineupOperatorTemplate" DataType="{x:Type vm:PlannerOperatorItem}">
            <Border Width="30" Height="30" Margin="0,0,4,4" CornerRadius="5" ClipToBounds="True"
                    Background="{DynamicResource SectionBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="250">
                <Grid>
                    <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Saved lineup that survives every covenant ban of the current run; selectable for batch tracking -->
        <DataTemplate x:Key="SavedLineupCardTemplate" DataType="{x:Type vm:PlannerSavedLineupItem}">
            <Border CornerRadius="10" Padding="9,8" Margin="0,0,0,7"
                    ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="400">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ItemCardBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" VerticalAlignment="Center"
                                Background="{DynamicResource SuccessTintBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{DynamicResource SuccessTextBrush}" />
                        </Border>
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" Focusable="False"
                                  VerticalAlignment="Center" Margin="0,0,6,0"
                                  ToolTip="选中后可一次性把整套阵容的干员和装备需求加入追踪" />
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Margin="0,0,6,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Operators}" ItemTemplate="{StaticResource SavedLineupOperatorTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Covenants}" ItemTemplate="{StaticResource GoalPillTemplate}"
                                  Focusable="False" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Variant matrix cell -->
        <DataTemplate x:Key="VariantCellTemplate" DataType="{x:Type vm:PlannerVariantCell}">
            <Button Margin="0,0,4,4" Height="30" Cursor="Hand" ToolTip="{Binding ToolTip}"
                    Command="{Binding DataContext.SelectVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="frame" RadiusX="7" RadiusY="7" StrokeThickness="1"
                                       Stroke="{DynamicResource BorderBrush}" Fill="{DynamicResource CardBackgroundBrush}" />
                            <TextBlock x:Name="label" Text="{Binding Text}" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasResults}" Value="False">
                                <Setter TargetName="frame" Property="StrokeDashArray" Value="3 2" />
                                <Setter TargetName="frame" Property="Fill" Value="Transparent" />
                                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter TargetName="label" Property="FontWeight" Value="Normal" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="frame" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Result card -->
        <DataTemplate x:Key="LineupCardTemplate" DataType="{x:Type vm:PlannerLineupItem}">
            <Border Style="{StaticResource ItemCardBorder}" CornerRadius="10" Padding="8,9,8,8" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="保存" Style="{StaticResource PlannerPrimaryButton}" Padding="11,0"
                                ToolTip="保存为阵容（可在阵容页编辑装备）"
                                Command="{Binding DataContext.SaveLineupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button DockPanel.Dock="Right" Content="追踪" Style="{StaticResource PlannerGhostButton}" Margin="0,0,6,0"
                                ToolTip="把这些干员和装备需求加入追踪列表"
                                Command="{Binding DataContext.TrackLineupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PlannerHint}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Operators}" ItemTemplate="{StaticResource PlannedOperatorTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Goals}" ItemTemplate="{StaticResource GoalPillTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource PlannerHint}" Margin="0,2,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Step switch + run info -->
        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,8">
            <Border Background="{DynamicResource TitleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="3">
                <UniformGrid Columns="2">
                    <Button x:Name="GoalTabButton" Margin="0,0,2,0"
                            Content="{Binding GoalTabText}" Command="{Binding ShowGoalPageCommand}" >
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlannerSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowResults}" Value="False">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ResultTabButton" Margin="2,0,0,0"
                            Content="{Binding ResultTabText}" Command="{Binding ShowResultPageCommand}" >
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlannerSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowResults}" Value="True">
                                        <Setter Property="Tag" Value="Active" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
            </Border>
            <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowResults, Converter={StaticResource InverseBoolToVis}}">
                <CheckBox DockPanel.Dock="Right" Content="只看本局" FontSize="11" VerticalContentAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="{Binding OnlyCurrentRun}"
                          IsEnabled="{Binding HasRunInfo}" ToolTip="只显示本局可用的盟约（已选目标始终显示）" />
                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"
                         Visibility="{Binding HasRunInfo, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding RunInfoText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </DockPanel>
        </StackPanel>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource TitleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,8,10,9">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PlannerPrimaryButton}" Height="30" Padding="14,0" FontSize="12"
                        Content="{Binding ViewResultsText}" Command="{Binding ShowResultPageCommand}"
                        Visibility="{Binding ShowResults, Converter={StaticResource InverseBoolToVis}}" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource PlannerHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,3,0,0" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- ① Targets -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10"
                          Visibility="{Binding ShowResults, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="清空目标" Style="{StaticResource PlannerLinkButton}"
                                Command="{Binding ClearGoalsCommand}" Visibility="{Binding HasGoals, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="核心盟约" Style="{StaticResource PlannerSectionTitle}" />
                        <TextBlock Text="Ⅰ 3 人 · Ⅱ 6 人" Style="{StaticResource PlannerHint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding CoreCovenants}" ItemTemplate="{StaticResource CovenantTileTemplate}"
                                  ItemsPanel="{StaticResource TwoColumnPanel}" ItemContainerStyle="{StaticResource CovenantContainerStyle}"
                                  Focusable="False" />

                    <DockPanel Margin="0,10,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="Ⅱ* 需人工确认条件" Style="{StaticResource PlannerHint}" VerticalAlignment="Center" />
                        <TextBlock Text="附加盟约" Style="{StaticResource PlannerSectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ExtraCovenants}" ItemTemplate="{StaticResource CovenantTileTemplate}"
                                  ItemsPanel="{StaticResource TwoColumnPanel}" ItemContainerStyle="{StaticResource CovenantContainerStyle}"
                                  Focusable="False" />

                    <DockPanel Margin="0,10,0,6">
                        <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource PlannerLinkButton}"
                                Command="{Binding ClearLockedCommand}" Visibility="{Binding HasLocked, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="必带干员" Style="{StaticResource PlannerSectionTitle}" />
                        <TextBlock Text="已在场上 / 一定要带的人" Style="{StaticResource PlannerHint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Height="30" Padding="8,0">
                        <Grid>
                            <TextBlock Text="搜索干员，回车锁定" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=LockSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="LockSearchBox" Background="Transparent" BorderThickness="0" FontSize="11"
                                     VerticalContentAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     Text="{Binding LockSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnLockSearchKeyDown" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding LockSuggestions}" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PlannerGhostButton}" Margin="0,0,5,5" Padding="3,0,9,0"
                                        Tag="{Binding}" ToolTip="{StaticResource OperatorDetailsToolTip}" ToolTipService.InitialShowDelay="300"
                                        Command="{Binding DataContext.LockOperatorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="18" Height="18" Margin="0,0,5,0">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding LockedOperators}" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlannerLockedOperator}">
                                <Border Height="24" CornerRadius="12" Margin="0,0,5,5" Padding="3,0,2,0" BorderThickness="1"
                                        Tag="{Binding Operator}" ToolTip="{StaticResource OperatorDetailsToolTip}" ToolTipService.InitialShowDelay="300"
                                        Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="18" Height="18" Margin="0,0,5,0">
                                            <Ellipse Fill="{DynamicResource SectionBackgroundBrush}" />
                                            <TextBlock Text="{Binding Initial}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Button Content="✕" Style="{StaticResource PlannerLinkButton}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                Margin="5,0,4,0" Command="{Binding RemoveCommand}" ToolTip="取消锁定" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Content="＋ 从追踪导入" Style="{StaticResource PlannerGhostButton}"
                            Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                            Command="{Binding ImportTrackedCommand}" ToolTip="把追踪列表里的干员设为必带" />

                    <!-- 已保存阵容中，后期激活盟约全部未被本局禁用的队伍 -->
                    <DockPanel Margin="0,14,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MatchingLineupSummary}"
                                   Style="{StaticResource PlannerHint}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <TextBlock Text="符合本局的阵容" Style="{StaticResource PlannerSectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="按后期阵容判断：激活的盟约全部未被禁用才列出。"
                               Style="{StaticResource PlannerHint}" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,6" LastChildFill="False"
                               Visibility="{Binding HasMatchingLineups, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Left" Content="{Binding SelectAllMatchingText}" Style="{StaticResource PlannerLinkButton}"
                                Command="{Binding ToggleSelectAllMatchingCommand}" ToolTip="全选或取消全选当前列出的阵容" />
                        <Button DockPanel.Dock="Right" Content="{Binding TrackSelectedText}" Style="{StaticResource PlannerPrimaryButton}"
                                Height="24" Padding="9,0" Command="{Binding TrackSelectedSavedLineupsCommand}"
                                IsEnabled="{Binding HasSelectedMatchingLineups}"
                                ToolTip="把已选阵容的后期干员和装备需求一次性加入追踪列表" />
                    </DockPanel>
                    <TextBlock Text="{Binding MatchingLineupHint}" Style="{StaticResource PlannerHint}" Margin="0,2,0,6"
                               Visibility="{Binding HasMatchingLineups, Converter={StaticResource InverseBoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding MatchingLineups}" ItemTemplate="{StaticResource SavedLineupCardTemplate}"
                                  Focusable="False" Visibility="{Binding HasMatchingLineups, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ② Results -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10"
                          Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="改目标" Style="{StaticResource PlannerLinkButton}" Command="{Binding ShowGoalPageCommand}" />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding GoalChips}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="11" Padding="8,1" Margin="0,0,5,4" BorderThickness="1"
                                                Background="{DynamicResource EliteTintBrush}" BorderBrush="{DynamicResource EliteBrush}">
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource EliteBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border CornerRadius="11" Padding="8,1" Margin="0,0,5,4" BorderThickness="1"
                                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                    Visibility="{Binding HasLocked, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="必带" /><Run Text="{Binding LockedOperators.Count, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </DockPanel>

                    <!-- people × transforms matrix -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <UniformGrid Grid.Column="1" Columns="3" Margin="0,0,0,3">
                            <TextBlock Text="0 转" Style="{StaticResource PlannerHint}" TextAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="1 转" Style="{StaticResource PlannerHint}" TextAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="2 转" Style="{StaticResource PlannerHint}" TextAlignment="Center" Margin="0,0,4,0" />
                        </UniformGrid>
                        <UniformGrid Grid.Row="1" Rows="2">
                            <TextBlock Text="8 人" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="9 人" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </UniformGrid>
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VariantCells}"
                                      ItemTemplate="{StaticResource VariantCellTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <TextBlock Text="{Binding ResultHint}" Style="{StaticResource PlannerHint}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding VisibleLineups}" ItemTemplate="{StaticResource LineupCardTemplate}" Focusable="False" />
                    <TextBlock Text="{Binding EmptyResultText}" Style="{StaticResource PlannerHint}"
                               Margin="0,12,0,0" TextAlignment="Center"
                               Visibility="{Binding HasVisibleLineups, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
