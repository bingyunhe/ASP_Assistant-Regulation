<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.LineupListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:models="clr-namespace:ASPAssistant.Core.Models;assembly=ASPAssistant.Core"
             xmlns:viewModels="clr-namespace:ASPAssistant.Core.ViewModels;assembly=ASPAssistant.Core"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />
        <converters:LineupTrackedConverter x:Key="LineupTracked" />
        <Geometry x:Key="LineupMoveUpIcon">M 12 20 L 12 5 M 6 11 L 12 5 L 18 11</Geometry>
        <Geometry x:Key="LineupMoveDownIcon">M 12 4 L 12 19 M 6 13 L 12 19 L 18 13</Geometry>
        <Geometry x:Key="LineupMoveTopIcon">M 5 4 L 19 4 M 12 20 L 12 9 M 6 15 L 12 9 L 18 15</Geometry>
        <Style x:Key="LineupOrderButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Top buttons (new / import) -->
        <Style x:Key="LineupTopButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RowCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineupPrimaryButton" TargetType="Button" BasedOn="{StaticResource LineupTopButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Card-bottom small button (edit / share / track / delete) -->
        <Style x:Key="LineupCardActionButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineupCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </Trigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding><MultiBinding Converter="{StaticResource LineupTracked}"><Binding Path="Id" /><Binding Path="TrackedLineupIds" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header: title · count · 导入 · 新建 -->
        <DockPanel DockPanel.Dock="Top" Margin="10,12,10,8">
            <Button DockPanel.Dock="Right" Content="新建" Style="{StaticResource LineupPrimaryButton}" Margin="6,0,0,0" Click="OnNewLineup" />
            <Button DockPanel.Dock="Right" Content="导入" Style="{StaticResource LineupTopButton}" Click="OnImportLineup"
                    ToolTip="粘贴分享码或分享链接导入阵容" />
            <TextBlock Text="我的阵容" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding VisibleLineups.Count, StringFormat={}{0} 套}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="10,0,10,4">
        <ListBox x:Name="AvailabilityFilterList" HorizontalAlignment="Left" Margin="0,0,8,4"
                 Style="{StaticResource SegmentedListBox}" SelectedValuePath="Tag" SelectedValue="{Binding SelectedAvailabilityFilter}">
            <ListBoxItem Content="全部" Tag="{x:Static viewModels:AvailabilityFilter.All}" />
            <ListBoxItem Content="本局可用" Tag="{x:Static viewModels:AvailabilityFilter.Available}" />
            <ListBoxItem Content="不可用" Tag="{x:Static viewModels:AvailabilityFilter.Unavailable}" />
        </ListBox>
            <Button x:Name="ClearHighlightsButton" Content="清除高亮" Click="OnClearHighlights" Margin="0,0,0,4"
                    ToolTip="取消阵容卡片高亮，保留追踪目标和来源关联">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SmallActionButton}">
                    <Style.Triggers><DataTrigger Binding="{Binding TrackedLineupIds.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                </Style></Button.Style>
            </Button>
        </WrapPanel>

        <!-- Lineup list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
            <Grid>
                <controls:EmptyState x:Name="EmptyHint" Visibility="Collapsed" Margin="28,60,28,0" VerticalAlignment="Top"
                                     Icon="{StaticResource IconLineups}" Title="还没有阵容"
                                     Hint="点右上角“新建”自己搭，或“导入”别人分享的阵容码。规划页的方案也能直接保存过来。" />

                <ItemsControl x:Name="LineupItems" ItemsSource="{Binding VisibleLineups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Lineup}">
                            <Border Style="{StaticResource LineupCardStyle}" Tag="{Binding Id}">
                                <StackPanel>
                                    <!-- Name · people -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Slots.Count, StringFormat={}{0} 人}" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="追踪中" FontSize="10" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                                <DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource LineupTracked}"><Binding Path="Id" /><Binding Path="TrackedLineupIds" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></DataTrigger.Binding><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    </DockPanel>

                                    <!-- Activated covenants as people, e.g. "乌萨斯 6" -->
                                    <ItemsControl Tag="{Binding Id}" Loaded="OnCovenantPillsLoaded" Margin="0,7,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="pill" CornerRadius="{DynamicResource PillCornerRadius}" Padding="7,1" Margin="0,0,4,4"
                                                        Background="{DynamicResource NeutralTintBrush}">
                                                    <TextBlock x:Name="pillText" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Count, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCore}" Value="True">
                                                        <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCore}" Value="False">
                                                        <Setter TargetName="pill" Property="Background" Value="{DynamicResource FinalTintBrush}" />
                                                        <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Operators -->
                                    <ItemsControl ItemsSource="{Binding Slots}" Margin="0,5,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:LineupSlot}">
                                                <controls:Avatar Height="28" Margin="0,0,4,4" Text="{Binding OperatorName}"
                                                                 Source="{Binding OperatorName, StringFormat=icons/operators/{0}.png}"
                                                                 ToolTip="{Binding OperatorName}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Actions -->
                                    <WrapPanel Margin="0,6,0,0">
                                            <Button Content="追踪" Tag="{Binding Id}" Style="{StaticResource LineupCardActionButton}"
                                                    Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                                    Background="{DynamicResource AccentSoftBrush}" FontWeight="Bold"
                                                    Click="OnTrackLineup" ToolTip="把这套阵容的干员加入追踪" />
                                            <Button Content="编辑" Tag="{Binding Id}" Style="{StaticResource LineupCardActionButton}" Click="OnEditLineup" />
                                            <Button Content="分享" Tag="{Binding Id}" Style="{StaticResource LineupCardActionButton}" Click="OnShareLineup" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button Tag="{StaticResource LineupMoveUpIcon}" Style="{StaticResource LineupOrderButton}"
                                                    CommandParameter="-1" Click="OnMoveLineup" Loaded="OnMoveButtonLoaded" ToolTip="上移阵容" />
                                            <Button Tag="{StaticResource LineupMoveDownIcon}" Style="{StaticResource LineupOrderButton}"
                                                    CommandParameter="1" Click="OnMoveLineup" Loaded="OnMoveButtonLoaded" ToolTip="下移阵容" />
                                            <Button Tag="{StaticResource LineupMoveTopIcon}" Style="{StaticResource LineupOrderButton}"
                                                    CommandParameter="0" Click="OnMoveLineup" Loaded="OnMoveButtonLoaded" ToolTip="置顶阵容" />
                                            <Button Width="28" Height="28" Tag="{StaticResource IconDelete}"
                                                    Style="{StaticResource RowIconButton}" Click="OnDeleteLineup" ToolTip="删除阵容" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
