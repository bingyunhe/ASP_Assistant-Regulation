<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.LineupListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:models="clr-namespace:ASPAssistant.Core.Models;assembly=ASPAssistant.Core"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />

        <!-- Top buttons (new / import) -->
        <Style x:Key="LineupTopButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RowCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineupPrimaryButton" TargetType="Button" BasedOn="{StaticResource LineupTopButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Card-bottom small button (edit / share / track / delete) -->
        <Style x:Key="LineupCardActionButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineupCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header: title · count · 导入 · 新建 -->
        <DockPanel DockPanel.Dock="Top" Margin="10,12,10,8">
            <Button DockPanel.Dock="Right" Content="新建" Style="{StaticResource LineupPrimaryButton}" Margin="6,0,0,0" Click="OnNewLineup" />
            <Button DockPanel.Dock="Right" Content="导入" Style="{StaticResource LineupTopButton}" Click="OnImportLineup"
                    ToolTip="粘贴分享码或分享链接导入阵容" />
            <TextBlock Text="我的阵容" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Lineups.Count, StringFormat={}{0} 套}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>

        <!-- Lineup list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
            <Grid>
                <controls:EmptyState x:Name="EmptyHint" Visibility="Collapsed" Margin="28,60,28,0" VerticalAlignment="Top"
                                     Icon="{StaticResource IconLineups}" Title="还没有阵容"
                                     Hint="点右上角“新建”自己搭，或“导入”别人分享的阵容码。规划页的方案也能直接保存过来。" />

                <ItemsControl x:Name="LineupItems" ItemsSource="{Binding Lineups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Lineup}">
                            <Border Style="{StaticResource LineupCardStyle}" Tag="{Binding Id}">
                                <StackPanel>
                                    <!-- Name · people -->
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Slots.Count, StringFormat={}{0} 人}" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    </DockPanel>

                                    <!-- Activated covenants as people, e.g. "乌萨斯 6" -->
                                    <ItemsControl Tag="{Binding Id}" Loaded="OnCovenantPillsLoaded" Margin="0,7,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="pill" CornerRadius="{DynamicResource PillCornerRadius}" Padding="7,1" Margin="0,0,4,4"
                                                        Background="{DynamicResource NeutralTintBrush}">
                                                    <TextBlock x:Name="pillText" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Count, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCore}" Value="True">
                                                        <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCore}" Value="False">
                                                        <Setter TargetName="pill" Property="Background" Value="{DynamicResource FinalTintBrush}" />
                                                        <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Operators -->
                                    <ItemsControl ItemsSource="{Binding Slots}" Margin="0,5,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:LineupSlot}">
                                                <controls:Avatar Height="28" Margin="0,0,4,4" Text="{Binding OperatorName}"
                                                                 Source="{Binding OperatorName, StringFormat=icons/operators/{0}.png}"
                                                                 ToolTip="{Binding OperatorName}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Actions -->
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Width="28" Height="28" Tag="{StaticResource IconDelete}"
                                                Style="{StaticResource RowIconButton}" Click="OnDeleteLineup" ToolTip="删除阵容" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="追踪" Tag="{Binding Id}" Style="{StaticResource LineupCardActionButton}"
                                                    Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                                                    Background="{DynamicResource AccentSoftBrush}" FontWeight="Bold"
                                                    Click="OnTrackLineup" ToolTip="把这套阵容的干员加入追踪" />
                                            <Button Content="编辑" Tag="{Binding Id}" Style="{StaticResource LineupCardActionButton}" Click="OnEditLineup" />
                                            <Button Content="分享" Tag="{Binding Id}" Style="{StaticResource LineupCardActionButton}" Click="OnShareLineup" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
