<!-- Added for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="TallSegItem" TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="DeployCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,5,8" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Footer: show in game + recompute -->
        <Border x:Name="MapFooter" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,7"
                Background="{DynamicResource CardBackgroundBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="RecomputeButton" Content="重新计算" Tag="accent"
                        Style="{StaticResource SmallActionButton}" Click="OnRecompute" />
                <CheckBox x:Name="InGameToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                          Checked="OnInGameToggled" Unchecked="OnInGameToggled" />
                <TextBlock Text="游戏内显示" FontSize="11" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="格子 · 名字 · 朝向" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Margin="10,10,5,8">
                <!-- ── Main view ─────────────────────────────────────────── -->
                <StackPanel x:Name="MainPanel">
                    <!-- Map: thumbnail, name, status in one row -->
                    <Border Style="{StaticResource DeployCard}" Padding="8,7">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="66" Height="34" CornerRadius="4" ClipToBounds="True" Margin="0,0,9,0"
                                    Background="{DynamicResource SectionBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Image x:Name="MapThumb" Stretch="UniformToFill" />
                            </Border>
                            <Button DockPanel.Dock="Right" Content="⇄" Width="28" Height="28" Padding="0" Margin="6,0,0,0" ToolTip="换地图"
                                    Style="{StaticResource SmallActionButton}" Click="OnPickMap" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MapName" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <Ellipse x:Name="MapSourceDot" Width="6" Height="6" Margin="6,0,3,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MapSourceText" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="MapSubline" FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Toolbar: mode + field size -->
                    <DockPanel Margin="0,0,5,8">
                        <ListBox x:Name="FieldCountList" DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource SegmentedListBox}" ItemContainerStyle="{StaticResource TallSegItem}"
                                 SelectionChanged="OnFieldCountChanged" ToolTip="上场人数">
                            <ListBoxItem Content="8" />
                            <ListBoxItem Content="9" />
                        </ListBox>
                        <ListBox x:Name="ModeList" Style="{StaticResource SegmentedListBox}" ItemContainerStyle="{StaticResource TallSegItem}"
                                 SelectionChanged="OnModeChanged" ToolTip="战斗：只看防线和输出；叠层：优先叠盟约层数">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Content="战斗" />
                            <ListBoxItem Content="平衡" />
                            <ListBoxItem Content="叠层" />
                        </ListBox>
                    </DockPanel>

                    <!-- Mini board -->
                    <Border x:Name="BoardCard" Style="{StaticResource DeployCard}" Padding="6,8,6,7">
                        <StackPanel>
                            <Viewbox Stretch="Uniform" MaxWidth="380" HorizontalAlignment="Center"
                                     ToolTip="拖动干员换位置，点一下看详情">
                                <Canvas x:Name="BoardCanvas" Background="Transparent"
                                        MouseMove="OnBoardMouseMove" MouseLeftButtonUp="OnBoardMouseUp" />
                            </Viewbox>
                            <Border x:Name="ChecksBorder" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="2,6,2,0" Padding="0,6,0,0">
                                <WrapPanel x:Name="ChecksRow" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText" FontSize="11" Margin="2,0,5,8" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />

                    <!-- Plan: checks + operators -->
                    <StackPanel x:Name="PlanPanel">
                        <UniformGrid x:Name="OperatorGrid" Columns="2" Margin="0,0,1,4" />
                    </StackPanel>

                    <!-- Detail of the selected operator -->
                    <Border x:Name="DetailCard" Style="{StaticResource DeployCard}" Visibility="Collapsed">
                        <StackPanel x:Name="DetailBody" />
                    </Border>

                    <!-- Bench + pool entry -->
                    <Border x:Name="BenchCard" Style="{StaticResource DeployCard}" Padding="10,8">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="PoolSummary" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="PoolMeta" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </DockPanel>
                            <UniformGrid x:Name="BenchRow" Columns="2" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Pool view ─────────────────────────────────────────── -->
                <StackPanel x:Name="PoolPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,0,5,6">
                        <Border Height="32" CornerRadius="{DynamicResource RowCornerRadius}" BorderThickness="1"
                                Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <TextBox x:Name="PoolSearch" Padding="24,0,8,0" VerticalContentAlignment="Center" FontSize="12"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}" TextChanged="OnPoolSearchChanged" />
                            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                  Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
                            <TextBlock x:Name="PoolSearchHint" Text="搜名字或盟约" FontSize="12" Margin="27,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                        </Grid>
                        </Border>
                    </DockPanel>
                    <WrapPanel Margin="0,0,5,6">
                        <ListBox x:Name="PoolFilterList" Style="{StaticResource SegmentedListBox}" SelectionChanged="OnPoolFilterChanged" SelectedIndex="0" Margin="0,0,6,4">
                            <ListBoxItem Content="全部" /><ListBoxItem Content="已获取" />
                        </ListBox>
                        <Button Content="本阶段已获取" Margin="0,0,5,4" Style="{StaticResource SmallActionButton}" Click="OnOwnCurrentStage" ToolTip="标记大成与未过期过渡干员已获取，不会自动标记精锐" />
                        <Button Content="＋ 添加" Margin="0,0,0,4" Tag="accent" Style="{StaticResource SmallActionButton}" Click="OnAddOther" />
                    </WrapPanel>
                    <TextBlock x:Name="PoolHeaderMeta" FontSize="10.5" TextWrapping="Wrap" Margin="2,0,5,7" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel x:Name="PoolGroups" Margin="0,0,5,0" />
                </StackPanel>

                <!-- ── No map ────────────────────────────────────────────── -->
                <StackPanel x:Name="NoMapPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource DeployCard}">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="NoMapBack" DockPanel.Dock="Right" Content="‹ 返回" Style="{StaticResource LinkButton}"
                                        Click="OnBackToMain" />
                                <TextBlock x:Name="NoMapTitle" Text="还没认出当前地图" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </DockPanel>
                            <TextBlock x:Name="NoMapHint" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="进入休整期、能看到完整棋盘时会自动识别。也可以先手动选：" />
                            <UniformGrid x:Name="MapChoices" Columns="2" Margin="0,9,0,0" />
                            <Button x:Name="FollowRecognitionButton" Content="改回自动识别" Margin="0,4,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource SmallActionButton}" Click="OnFollowRecognition" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
