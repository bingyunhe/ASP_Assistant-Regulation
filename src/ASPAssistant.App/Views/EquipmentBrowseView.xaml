<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.EquipmentBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             Background="{DynamicResource PanelBackgroundBrush}"
             DataContextChanged="OnViewDataContextChanged">
    <UserControl.Resources>
        <converters:NullToStringConverter x:Key="NullToAll" />
        <converters:TierToRomanConverter x:Key="TierToRoman" />
        <CollectionViewSource x:Key="EquipmentByTier" Source="{Binding FilteredEquipment}">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="Tier" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Tier" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <DockPanel>
        <!-- Search -->
        <Border DockPanel.Dock="Top" Margin="10,10,10,8" Height="32" Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}" Padding="9,0">
            <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Grid>
                    <TextBlock Text="搜索装备或效果" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0" Padding="0" FontSize="12" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource AccentBrush}" />
                </Grid>
            </DockPanel>
        </Border>
        <!-- 全部 / 普通 / 转职 · 筛选 -->
        <DockPanel DockPanel.Dock="Top" Margin="10,0,10,0" LastChildFill="False">
            <ToggleButton x:Name="FilterToggle" DockPanel.Dock="Right" Style="{StaticResource FilterTogglePill}" Content="筛选" />
            <ListBox x:Name="TypeFilterList" DockPanel.Dock="Left" Style="{StaticResource SegmentedListBox}"
                     SelectedIndex="{Binding TypeIndex, Mode=TwoWay}">
                <ListBoxItem Content="全部" />
                <ListBoxItem Content="普通" />
                <ListBoxItem Content="转职" />
            </ListBox>
        </DockPanel>

        <!-- Collapsed: chosen conditions as removable tags -->
        <ItemsControl DockPanel.Dock="Top" Margin="10,8,10,0" Focusable="False"
                      ItemsSource="{Binding ActiveChips}" ItemTemplate="{StaticResource FilterTagTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasActiveChips}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=FilterToggle}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>

        <!-- Expanded: the filter card -->
        <Border DockPanel.Dock="Top" Margin="10,8,10,2" Style="{StaticResource FilterCard}"
                Visibility="{Binding IsChecked, ElementName=FilterToggle, Converter={StaticResource DetailsBoolToVis}}">
            <StackPanel>
                <TextBlock Text="等阶" Style="{StaticResource FilterSectionTitle}" Margin="0,0,0,7" />
                <ItemsControl ItemsSource="{Binding TierChips}" Focusable="False" Margin="0,0,-4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><ToggleButton Style="{StaticResource TierCellToggle}" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Margin="0,12" Background="{DynamicResource LineBrush}" />

                <DockPanel Margin="0,0,0,7">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource MatchModeToggle}" IsChecked="{Binding CategoryMatchAll}" />
                    <TextBlock Text="功能分类" Style="{StaticResource FilterSectionTitle}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding CategoryChips}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><ToggleButton Style="{StaticResource FilterChipToggle}" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,7,0,0" Padding="0,10,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="收起" Height="30" Padding="14,0" Margin="6,0,0,0" Tag="accent"
                                Style="{StaticResource SmallActionButton}" Click="OnCollapseFiltersClicked" />
                        <Button DockPanel.Dock="Right" Content="重置" Height="30" Padding="12,0"
                                Style="{StaticResource SmallActionButton}" ToolTip="把所有筛选恢复为默认" Click="OnResetFiltersClicked" />
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="符合条件 " /><Run Text="{Binding MatchedCount, Mode=OneWay}" FontWeight="Bold" FontSize="13"
                                 FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text=" 件" />
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
        <Grid Margin="0,4,0,0">
            <!-- Two columns of compact cells grouped by tier; details on hover -->
            <ItemsControl x:Name="EquipmentListControl" ItemsSource="{Binding Source={StaticResource EquipmentByTier}}"
                          VirtualizingPanel.IsVirtualizing="False"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False">
                            <ItemsPresenter Margin="10,0,5,10" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <!-- inside a tier: two cells per row -->
                    <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource TierGroupHeader}">
                        <GroupStyle.Panel>
                            <!-- tiers one under another -->
                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:EquipmentCell TrackingToggled="OnEquipmentTrackingToggled" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:EmptyState x:Name="EmptyFilterText" Icon="{StaticResource IconEquipment}" Title="{Binding EmptyListMessage}"
                                 Hint="换个关键词，或在筛选里点“重置”。">
                <controls:EmptyState.Style>
                    <Style TargetType="controls:EmptyState">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredEquipment.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyState.Style>
            </controls:EmptyState>
        </Grid>
    </DockPanel>
</UserControl>
