<UserControl x:Class="ASPAssistant.App.Controls.EquipmentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters">
    <UserControl.Resources>
        <converters:TierToRomanConverter x:Key="TierToRoman" />
    </UserControl.Resources>

    <Border Style="{StaticResource ItemCardBorder}">
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Tier, Converter={StaticResource TierToRoman}}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="Bold" FontSize="13" Margin="0,0,5,0" />
                <TextBlock x:Name="NameText" Text="{Binding Name}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
            </DockPanel>
            <!-- Function categories (攻击/防御/生存/技力/经济/盟约/其他) -->
            <ItemsControl x:Name="CategoryChips" ItemsSource="{Binding Categories}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource NeutralTintBrush}" CornerRadius="{DynamicResource RowCornerRadius}"
                                Padding="5,1" Margin="0,0,4,0">
                            <TextBlock Text="{Binding}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,8,0"
                        CornerRadius="{DynamicResource RowCornerRadius}" Background="{DynamicResource NeutralHoverBrush}" VerticalAlignment="Top"
                        ClipToBounds="True">
                    <Image x:Name="IconImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock x:Name="NoEliteText" Text="无精锐装备"
                               Visibility="Collapsed" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="JobChangeText" Visibility="Collapsed"
                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}" />
                    <Button x:Name="TrackButton" HorizontalAlignment="Right"
                            Style="{StaticResource TrackingButton}"
                            Margin="0,6,0,0" Click="OnTrackClick" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="EffectText" Margin="0,4,0,0"
                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
