<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Controls.OperatorCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             PreviewMouseWheel="OnPreviewMouseWheel">
    <!-- Operator row: tier stripe · avatar · name / covenant pills · ☆ ⊘ -->
    <Border x:Name="CardBorder" Height="53" BorderThickness="1" CornerRadius="{DynamicResource RowCornerRadius}" Margin="0,0,5,5"
            ToolTipService.InitialShowDelay="250"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.ShowDuration="60000">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            </Style>
        </Border.Style>
        <Border.ToolTip>
            <ToolTip x:Name="DetailsToolTip" Placement="Left"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False"
                     MaxHeight="700">
                <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="6"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- filled only while open (see OperatorCard.xaml.cs): building every row's details up front made the list slow -->
                        <ContentControl x:Name="DetailsHost" ContentTemplate="{StaticResource OperatorDetailsTemplate}" />
                    </ScrollViewer>
                </Border>
            </ToolTip>
        </Border.ToolTip>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource HoverFadeOverlay}" />
            <!-- Tier stripe: gold for Ⅴ/Ⅵ, accent for Ⅳ -->
            <Border x:Name="TierRail" Width="3" Margin="0,11" CornerRadius="0,2,2,0" Background="{DynamicResource BorderBrush}" />
            <controls:Avatar x:Name="TrackingPortrait" Grid.Column="1" Width="34" Height="34" Margin="7,0,9,0" VerticalAlignment="Center"
                             Text="{Binding Name}" Source="{Binding IconPath}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,2,0">
                <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <!-- Covenant pills: core filled in the accent tint, additional neutral -->
                <ItemsControl x:Name="CovenantChips" Margin="0,4,0,0" ClipToBounds="True" Focusable="False" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="chip" CornerRadius="{DynamicResource PillCornerRadius}" Padding="6,0" Margin="0,0,4,0"
                                    Background="{DynamicResource NeutralTintBrush}">
                                <TextBlock x:Name="chipText" Text="{Binding Name}" FontSize="10" LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCore}" Value="True">
                                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter TargetName="chipText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="chipText" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel x:Name="ActionButtons" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button x:Name="AcquiredButton" Visibility="Collapsed" Click="OnAcquiredClick" />
                <Button x:Name="TrackButton" Width="28" Height="28" Tag="{StaticResource IconStar}"
                        Style="{StaticResource RowIconButton}" Click="OnTrackClick" />
                <Button x:Name="BanButton" Width="28" Height="28" Tag="{StaticResource IconBan}"
                        Style="{StaticResource RowIconButton}" Click="OnBanClick" />
            </StackPanel>
            <!-- kept for the banned state text in tooltips / tests -->
            <Border x:Name="BanBadge" Visibility="Collapsed" Width="0" />
        </Grid>
    </Border>
</UserControl>
